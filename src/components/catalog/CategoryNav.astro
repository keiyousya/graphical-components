---
import { categories, getComponentsByCategory } from "../../data/components";
import { url } from "../../utils/paths";

const currentPath = Astro.url.pathname;
---

<div class="space-y-1">
  <p class="font-mono text-[10px] text-cyber-600 uppercase tracking-widest mb-3 px-2">
    Categories
  </p>
  {
    categories.map((cat) => {
      const count = getComponentsByCategory(cat.id).length;
      const href = url(`/components/${cat.id}`);
      const isActive = currentPath.startsWith(href);
      return (
        <a
          href={href}
          class:list={[
            "group flex items-center gap-3 px-3 py-2 text-sm transition-colors",
            "border-l-2 hover:bg-cyber-900/30",
            isActive
              ? "border-cyber-500 text-cyber-300 bg-cyber-900/20"
              : "border-transparent text-cyber-500 hover:text-cyber-300 hover:border-cyber-700",
          ]}
        >
          <span class="text-base opacity-60 group-hover:opacity-100 transition-opacity">
            {cat.icon}
          </span>
          <span class="flex-1 font-ui">{cat.nameJa}</span>
          <span class="font-mono text-[10px] text-cyber-700">{count}</span>
        </a>
      );
    })
  }
</div>
