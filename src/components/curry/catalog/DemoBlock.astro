---
interface Props {
  title: string;
  label?: string;
  class?: string;
}

const { title, label, class: className = "" } = Astro.props;
---

<div class:list={["space-y-3", className]}>
  <div class="flex items-baseline gap-3">
    <h3 class="font-ui text-sm font-semibold text-roux-600 tracking-wider">{title}</h3>
    {label && <span class="font-mono text-[10px] text-spice-400">{label}</span>}
  </div>
  <div class="relative">
    <slot />
  </div>
</div>
