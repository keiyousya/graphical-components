---
interface Props {
  variant?: "default" | "spice" | "matcha";
  class?: string;
}

const {
  variant = "default",
  class: className = "",
} = Astro.props;

const variantStyles = {
  default: "border-spice-300/30 bg-cream-50/70",
  spice: "border-spice-400/40 bg-spice-50/50",
  matcha: "border-matcha-300/30 bg-matcha-50/50",
};
---

<div
  class:list={[
    "relative border backdrop-blur-sm rounded-2xl p-5",
    variantStyles[variant],
    className,
  ]}
>
  <slot />
</div>

<style>
  div {
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  div:hover {
    border-color: oklch(0.68 0.14 60 / 0.35);
    box-shadow: 0 4px 16px oklch(0.68 0.14 60 / 0.08);
  }
</style>
