---
interface Props {
  label?: string;
  min?: number;
  max?: number;
  value?: number;
  unit?: string;
  class?: string;
}

const {
  label,
  min = 0,
  max = 100,
  value = 50,
  unit = "%",
  class: className = "",
} = Astro.props;
---

<div class:list={["cyber-slider", className]}>
  {
    label && (
      <div class="flex items-center justify-between mb-2">
        <span class="font-mono text-[10px] text-cyber-600 uppercase tracking-widest">
          {label}
        </span>
        <span class="font-mono text-xs text-cyber-400">
          <span class="slider-value">{value}</span>
          {unit}
        </span>
      </div>
    )
  }
  <div class="relative h-8 flex items-center">
    <!-- Track background -->
    <div class="absolute inset-x-0 h-1 bg-void-400 border border-cyber-800/30">
      <!-- Fill -->
      <div
        class="absolute inset-y-0 left-0 bg-gradient-to-r from-cyber-600 to-cyber-400 shadow-glow-sm transition-all"
        style={`width: ${((value - min) / (max - min)) * 100}%`}
      >
      </div>
      <!-- Tick marks -->
      <div class="absolute inset-0 flex justify-between px-px">
        {Array.from({ length: 11 }).map(() => (
          <div class="w-px h-full bg-cyber-800/30" />
        ))}
      </div>
    </div>
    <!-- Input -->
    <input
      type="range"
      min={min}
      max={max}
      value={value}
      class="slider-input absolute inset-x-0 w-full h-full opacity-0 cursor-pointer"
    />
    <!-- Thumb visual -->
    <div
      class="slider-thumb pointer-events-none absolute w-3 h-5 border border-cyber-400 bg-void-300 shadow-glow-sm transition-all"
      style={`left: calc(${((value - min) / (max - min)) * 100}% - 6px)`}
    >
      <div class="absolute inset-0.5 border border-cyber-500/40"></div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll(".cyber-slider").forEach((slider) => {
    const input = slider.querySelector<HTMLInputElement>(".slider-input");
    const thumb = slider.querySelector<HTMLElement>(".slider-thumb");
    const fill = slider.querySelector<HTMLElement>(".bg-gradient-to-r");
    const valueDisplay = slider.querySelector<HTMLElement>(".slider-value");
    if (!input || !thumb || !fill) return;

    input.addEventListener("input", () => {
      const min = Number(input.min);
      const max = Number(input.max);
      const pct = ((Number(input.value) - min) / (max - min)) * 100;
      fill.style.width = `${pct}%`;
      thumb.style.left = `calc(${pct}% - 6px)`;
      if (valueDisplay) valueDisplay.textContent = input.value;
    });
  });
</script>
