---
interface Props {
  size?: "sm" | "md" | "lg";
  blips?: { angle: number; distance: number; label?: string }[];
  class?: string;
}

const {
  size = "md",
  blips = [],
  class: className = "",
} = Astro.props;

const sizes = {
  sm: "size-40",
  md: "size-64",
  lg: "size-96",
};
---

<div
  class:list={["radar-sweep relative inline-flex items-center justify-center", sizes[size], className]}
  data-blips={JSON.stringify(blips)}
>
  <canvas class="radar-canvas absolute inset-0 w-full h-full"></canvas>
  <div class="relative z-10">
    <slot />
  </div>
</div>

<script>
  import * as THREE from "three";

  document.querySelectorAll<HTMLElement>(".radar-sweep").forEach((container) => {
    const canvas = container.querySelector<HTMLCanvasElement>(".radar-canvas");
    if (!canvas) return;

    const blips: { angle: number; distance: number; label?: string }[] =
      JSON.parse(container.dataset.blips || "[]");

    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-1.2, 1.2, 1.2, -1.2, 0.1, 10);
    camera.position.z = 5;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const cyberColor = new THREE.Color(0x00d4e5);

    // Concentric rings
    for (let r = 0.25; r <= 1; r += 0.25) {
      const ring = new THREE.RingGeometry(r - 0.005, r + 0.005, 64);
      const mat = new THREE.MeshBasicMaterial({
        color: cyberColor,
        transparent: true,
        opacity: 0.12,
        side: THREE.DoubleSide,
      });
      scene.add(new THREE.Mesh(ring, mat));
    }

    // Cross lines
    const crossMat = new THREE.LineBasicMaterial({ color: cyberColor, transparent: true, opacity: 0.1 });
    for (let angle = 0; angle < Math.PI; angle += Math.PI / 4) {
      const geo = new THREE.BufferGeometry().setFromPoints([
        new THREE.Vector3(-Math.cos(angle), -Math.sin(angle), 0),
        new THREE.Vector3(Math.cos(angle), Math.sin(angle), 0),
      ]);
      scene.add(new THREE.Line(geo, crossMat));
    }

    // Sweep line
    const sweepGeo = new THREE.BufferGeometry().setFromPoints([
      new THREE.Vector3(0, 0, 0),
      new THREE.Vector3(0, 1.05, 0),
    ]);
    const sweepMat = new THREE.LineBasicMaterial({
      color: cyberColor,
      transparent: true,
      opacity: 0.8,
    });
    const sweepLine = new THREE.Line(sweepGeo, sweepMat);
    scene.add(sweepLine);

    // Sweep trail (cone shape)
    const trailGeo = new THREE.CircleGeometry(1.05, 32, 0, Math.PI / 6);
    const trailMat = new THREE.MeshBasicMaterial({
      color: cyberColor,
      transparent: true,
      opacity: 0.06,
      side: THREE.DoubleSide,
    });
    const trail = new THREE.Mesh(trailGeo, trailMat);
    scene.add(trail);

    // Blips
    const blipMeshes: THREE.Mesh[] = [];
    blips.forEach((blip) => {
      const rad = (blip.angle * Math.PI) / 180;
      const dist = blip.distance * 0.01;
      const blipGeo = new THREE.CircleGeometry(0.025, 8);
      const blipMat = new THREE.MeshBasicMaterial({
        color: cyberColor,
        transparent: true,
        opacity: 0.9,
      });
      const mesh = new THREE.Mesh(blipGeo, blipMat);
      mesh.position.set(Math.cos(rad) * dist, Math.sin(rad) * dist, 0.01);
      scene.add(mesh);
      blipMeshes.push(mesh);
    });

    // Center dot
    const centerGeo = new THREE.CircleGeometry(0.03, 16);
    const centerMat = new THREE.MeshBasicMaterial({ color: cyberColor });
    scene.add(new THREE.Mesh(centerGeo, centerMat));

    function resize() {
      const rect = container.getBoundingClientRect();
      const s = Math.min(rect.width, rect.height);
      renderer.setSize(s, s);
      canvas.style.left = `${(rect.width - s) / 2}px`;
      canvas.style.top = `${(rect.height - s) / 2}px`;
    }

    let angle = 0;
    function animate() {
      angle += 0.015;
      sweepLine.rotation.z = angle;
      trail.rotation.z = angle - Math.PI / 6;

      // Blip pulse when swept
      blipMeshes.forEach((mesh, i) => {
        const blipAngle = (blips[i].angle * Math.PI) / 180;
        const diff = Math.abs(((angle % (Math.PI * 2)) - blipAngle + Math.PI * 2) % (Math.PI * 2));
        if (diff < 0.3) {
          (mesh.material as THREE.MeshBasicMaterial).opacity = 1;
          mesh.scale.setScalar(1.5);
        } else {
          (mesh.material as THREE.MeshBasicMaterial).opacity = Math.max(0.3, 1 - diff * 0.3);
          mesh.scale.setScalar(1);
        }
      });

      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    }

    resize();
    animate();
    const resizeObserver = new ResizeObserver(() => resize());
    resizeObserver.observe(container);
  });
</script>
