---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["circuit-pattern relative overflow-hidden", className]}>
  <svg class="absolute inset-0 w-full h-full opacity-[0.07]" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="circuit" x="0" y="0" width="120" height="120" patternUnits="userSpaceOnUse">
        <!-- Horizontal lines -->
        <line x1="0" y1="20" x2="40" y2="20" stroke="currentColor" stroke-width="1" />
        <line x1="60" y1="20" x2="120" y2="20" stroke="currentColor" stroke-width="1" />
        <line x1="0" y1="60" x2="30" y2="60" stroke="currentColor" stroke-width="1" />
        <line x1="90" y1="60" x2="120" y2="60" stroke="currentColor" stroke-width="1" />
        <line x1="20" y1="100" x2="80" y2="100" stroke="currentColor" stroke-width="1" />

        <!-- Vertical lines -->
        <line x1="40" y1="20" x2="40" y2="60" stroke="currentColor" stroke-width="1" />
        <line x1="80" y1="60" x2="80" y2="100" stroke="currentColor" stroke-width="1" />
        <line x1="100" y1="0" x2="100" y2="40" stroke="currentColor" stroke-width="1" />

        <!-- Nodes -->
        <circle cx="40" cy="20" r="3" fill="currentColor" />
        <circle cx="60" cy="20" r="2" fill="none" stroke="currentColor" stroke-width="1" />
        <circle cx="30" cy="60" r="3" fill="currentColor" />
        <circle cx="80" cy="60" r="2" fill="none" stroke="currentColor" stroke-width="1" />
        <circle cx="80" cy="100" r="3" fill="currentColor" />
        <circle cx="100" cy="40" r="2" fill="none" stroke="currentColor" stroke-width="1" />

        <!-- Corner turns -->
        <path d="M40 60 Q 40 80, 60 80" fill="none" stroke="currentColor" stroke-width="1" />
        <path d="M90 60 Q 90 40, 100 40" fill="none" stroke="currentColor" stroke-width="1" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#circuit)" class="text-cyber-500" />
  </svg>
  <slot />
</div>
