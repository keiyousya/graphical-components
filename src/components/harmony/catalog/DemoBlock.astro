---
interface Props {
  title: string;
  label?: string;
  class?: string;
}

const { title, label, class: className = "" } = Astro.props;
---

<div class:list={["demo-block", className]}>
  <div class="flex items-center gap-3 mb-3">
    <span class="text-[8px] text-rose-400 select-none">+</span>
    <h3 class="font-display text-xs tracking-widest text-ash-500 uppercase">{title}</h3>
    {label && (
      <span class="font-mono text-[10px] text-ash-300">{label}</span>
    )}
    <div class="h-px flex-1 bg-mist-500/30"></div>
  </div>
  <slot />
</div>
