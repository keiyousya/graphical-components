---
interface Props {
  title: string;
  tag?: string;
}

const { title, tag } = Astro.props;
---

<div class="mb-8">
  {tag && (
    <p class="font-mono text-[10px] text-hml-300 tracking-[0.3em] mb-1">
      &lt;{tag}&gt;
    </p>
  )}
  <h2 class="font-display text-xl md:text-2xl tracking-wider text-ash-700">
    {title}
  </h2>
  <div class="mt-2 h-px bg-gradient-to-r from-rose-400/40 via-mist-500/20 to-transparent"></div>
</div>
