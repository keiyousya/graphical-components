---
interface Props {
  variant?: "default" | "rose" | "will" | "vita";
  size?: "sm" | "md" | "lg";
  href?: string;
  class?: string;
}

const {
  variant = "default",
  size = "md",
  href,
  class: className = "",
} = Astro.props;

const Element = href ? "a" : "button";

const colors = {
  default: {
    base: "border-ash-300 text-ash-600",
    hover: "hover:border-rose-400 hover:text-ash-800 hover:bg-rose-50/50 hover:shadow-rose",
  },
  rose: {
    base: "border-rose-300 text-rose-700 bg-rose-50/30",
    hover: "hover:bg-rose-100/50 hover:shadow-rose hover:text-rose-800",
  },
  will: {
    base: "border-will-300 text-will-700 bg-will-50/30",
    hover: "hover:bg-will-100/50 hover:shadow-will hover:text-will-800",
  },
  vita: {
    base: "border-vita-400/40 text-vita-600",
    hover: "hover:bg-vita-300/10 hover:text-vita-700",
  },
};

const sizes = {
  sm: "px-4 py-1.5 text-xs gap-2",
  md: "px-6 py-2.5 text-sm gap-2.5",
  lg: "px-8 py-3 text-base gap-3",
};

const c = colors[variant];
---

<Element
  href={href}
  class:list={[
    "harmony-btn group relative inline-flex items-center border font-display tracking-[0.12em] uppercase transition-all duration-300 cursor-pointer",
    c.base,
    c.hover,
    sizes[size],
    className,
  ]}
>
  <slot />
</Element>

<style>
  .harmony-btn {
    background: oklch(0.98 0.003 350 / 0.5);
  }
  .harmony-btn:active {
    transform: scale(0.97);
  }
</style>
