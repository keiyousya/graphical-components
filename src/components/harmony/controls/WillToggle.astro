---
interface Props {
  label?: string;
  checked?: boolean;
  class?: string;
}

const {
  label,
  checked = false,
  class: className = "",
} = Astro.props;

const id = `will-toggle-${Math.random().toString(36).slice(2, 8)}`;
---

<label class:list={["will-toggle inline-flex items-center gap-3 cursor-pointer select-none", className]} for={id}>
  <div class="relative">
    <input
      type="checkbox"
      id={id}
      class="peer sr-only"
      checked={checked}
    />
    <div class="toggle-track w-11 h-6 border border-mist-500 bg-mist-300 rounded-full peer-checked:bg-rose-200 peer-checked:border-rose-400 transition-all duration-300">
    </div>
    <div class="toggle-dot absolute top-0.5 left-0.5 size-5 bg-mist-50 border border-mist-600 rounded-full transition-all duration-300 shadow-soft-sm peer-checked:translate-x-5 peer-checked:bg-rose-500 peer-checked:border-rose-600">
    </div>
  </div>
  {label && (
    <span class="font-display text-xs tracking-[0.1em] text-ash-500 uppercase">
      {label}
    </span>
  )}
</label>
