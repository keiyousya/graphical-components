---
interface Props {
  value: number;
  label: string;
  unit?: string;
  decimals?: number;
  class?: string;
}

const {
  value,
  label,
  unit = "",
  decimals = 0,
  class: className = "",
} = Astro.props;
---

<div class:list={["stat-value flex flex-col items-center gap-0.5", className]} data-target={value} data-decimals={decimals}>
  <span class="stat-number font-display text-2xl font-bold text-ash-700">
    0{unit}
  </span>
  <span class="font-mono text-[10px] text-ash-400 tracking-[0.1em] uppercase">
    {label}
  </span>
</div>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      observer.unobserve(el);
      const target = +(el.dataset.target ?? 0);
      const decimals = +(el.dataset.decimals ?? 0);
      const numEl = el.querySelector<HTMLSpanElement>(".stat-number");
      if (!numEl) return;
      const unit = numEl.textContent?.replace(/[\d.,]/g, "").trim() ?? "";
      const start = performance.now();
      const duration = 1200;
      const tick = (now: number) => {
        const t = Math.min((now - start) / duration, 1);
        const ease = 1 - Math.pow(1 - t, 3);
        numEl.textContent = (target * ease).toFixed(decimals) + unit;
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }, { threshold: 0.3 });
  document.querySelectorAll(".stat-value").forEach((el) => observer.observe(el));
</script>
