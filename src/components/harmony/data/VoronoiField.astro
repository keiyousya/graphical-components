---
interface Props {
  size?: "sm" | "md" | "lg";
  class?: string;
}

const {
  size = "md",
  class: className = "",
} = Astro.props;

const sizes = {
  sm: "h-48",
  md: "h-64",
  lg: "h-80",
};
---

<div class:list={["voronoi-field relative bg-mist-100 overflow-hidden", sizes[size], className]}>
  <canvas class="voronoi-canvas w-full h-full"></canvas>
</div>

<script>
  import * as THREE from "three";

  document.querySelectorAll<HTMLDivElement>(".voronoi-field").forEach((container) => {
    const canvas = container.querySelector<HTMLCanvasElement>(".voronoi-canvas");
    if (!canvas) return;

    const scene = new THREE.Scene();

    const camera = new THREE.PerspectiveCamera(70, canvas.clientWidth / canvas.clientHeight, 0.1, 100);
    camera.position.set(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
    renderer.setSize(canvas.clientWidth, canvas.clientHeight);
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));

    // -------------------------------------------------------
    // Voronoi cell wall — Worley noise fragment shader on
    // the inside of a sphere, simulating the organic room
    // from the movie.
    // -------------------------------------------------------

    const vertexShader = `
      varying vec3 vPosition;
      varying vec3 vNormal;
      varying vec2 vUv;

      void main() {
        vPosition = position;
        vNormal = normal;
        vUv = uv;
        gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
      }
    `;

    const fragmentShader = `
      uniform float uTime;
      varying vec3 vPosition;
      varying vec3 vNormal;
      varying vec2 vUv;

      // Hash function for pseudo-random
      vec3 hash3(vec3 p) {
        p = vec3(
          dot(p, vec3(127.1, 311.7, 74.7)),
          dot(p, vec3(269.5, 183.3, 246.1)),
          dot(p, vec3(113.5, 271.9, 124.6))
        );
        return fract(sin(p) * 43758.5453123);
      }

      // 3D Worley noise — returns (F1, F2) distances
      vec2 worley(vec3 p) {
        vec3 i_st = floor(p);
        vec3 f_st = fract(p);

        float d1 = 10.0; // closest
        float d2 = 10.0; // second closest

        for (int x = -1; x <= 1; x++) {
          for (int y = -1; y <= 1; y++) {
            for (int z = -1; z <= 1; z++) {
              vec3 neighbor = vec3(float(x), float(y), float(z));
              vec3 point = hash3(i_st + neighbor);

              // Slight animation
              point = 0.5 + 0.5 * sin(uTime * 0.15 + 6.2831 * point);

              vec3 diff = neighbor + point - f_st;
              float dist = length(diff);

              if (dist < d1) {
                d2 = d1;
                d1 = dist;
              } else if (dist < d2) {
                d2 = dist;
              }
            }
          }
        }

        return vec2(d1, d2);
      }

      void main() {
        // Use 3D position for seamless pattern on sphere
        vec3 p = vPosition * 2.5;

        vec2 w = worley(p);

        // Edge detection: thin dark lines at cell borders
        float edge = smoothstep(0.0, 0.08, w.y - w.x);

        // Cell interior: subtle shading based on distance from center
        float cellShade = smoothstep(0.0, 0.5, w.x);

        // Base colors — white/light gray cells with darker edges
        vec3 cellColor = vec3(0.94, 0.92, 0.92); // light warm white
        vec3 edgeColor = vec3(0.72, 0.68, 0.70); // warm gray for edges
        vec3 innerColor = vec3(0.88, 0.86, 0.86); // slightly darker cell center

        // Mix cell interior (subtle bump-like shading)
        vec3 color = mix(innerColor, cellColor, cellShade);

        // Apply edge
        color = mix(edgeColor, color, edge);

        // Subtle depth based on viewing angle
        float fresnel = 1.0 - abs(dot(normalize(vNormal), vec3(0.0, 0.0, 1.0)));
        color *= 1.0 - fresnel * 0.15;

        gl_FragColor = vec4(color, 1.0);
      }
    `;

    // Sphere viewed from inside
    const sphereGeo = new THREE.SphereGeometry(5, 64, 64);
    const material = new THREE.ShaderMaterial({
      vertexShader,
      fragmentShader,
      uniforms: {
        uTime: { value: 0 },
      },
      side: THREE.BackSide,
    });

    const sphere = new THREE.Mesh(sphereGeo, material);
    scene.add(sphere);

    let time = 0;

    function animate() {
      requestAnimationFrame(animate);
      time += 0.01;
      material.uniforms.uTime.value = time;

      // Slow camera look-around
      camera.rotation.y = Math.sin(time * 0.08) * 0.3;
      camera.rotation.x = Math.sin(time * 0.06) * 0.15;

      renderer.render(scene, camera);
    }

    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        observer.disconnect();
        animate();
      }
    });
    observer.observe(container);

    const ro = new ResizeObserver(() => {
      const w = container.clientWidth;
      const h = container.clientHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    });
    ro.observe(container);
  });
</script>
