---
interface Props {
  size?: "sm" | "md" | "lg";
  class?: string;
}

const {
  size = "md",
  class: className = "",
} = Astro.props;

const sizes = {
  sm: "h-48",
  md: "h-64",
  lg: "h-80",
};
---

<div class:list={["watchme-monitor relative overflow-hidden bg-mist-50", sizes[size], className]}>
  <canvas class="watchme-canvas w-full h-full"></canvas>
  <!-- Overlay data -->
  <div class="absolute top-3 left-3 font-mono text-[9px] text-hml-400/70 tracking-wider">
    <div>LifeSync v3.2.1</div>
    <div class="mt-0.5">BIOSYNC: <span class="text-vita-500">ACTIVE</span></div>
  </div>
  <div class="absolute bottom-3 right-3 font-mono text-[9px] text-hml-400/50 tracking-wider">
    &lt;body&gt; monitor
  </div>
</div>

<script>
  document.querySelectorAll<HTMLDivElement>(".watchme-monitor").forEach((container) => {
    const canvas = container.querySelector<HTMLCanvasElement>(".watchme-canvas");
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const resize = () => {
      const rect = container.getBoundingClientRect();
      canvas.width = rect.width * devicePixelRatio;
      canvas.height = rect.height * devicePixelRatio;
      ctx.scale(devicePixelRatio, devicePixelRatio);
    };
    resize();

    const w = () => canvas.width / devicePixelRatio;
    const h = () => canvas.height / devicePixelRatio;

    let time = 0;

    // Vitals data
    const vitals = [
      { label: "HR", value: 72, unit: "bpm", color: "oklch(0.58 0.14 0 / 0.6)" },
      { label: "SpO₂", value: 98, unit: "%", color: "oklch(0.60 0.16 155 / 0.6)" },
      { label: "BP", value: 120, unit: "mmHg", color: "oklch(0.50 0.16 325 / 0.5)" },
    ];

    function drawHeartbeat(cx: number, cy: number, width: number, height: number, t: number) {
      ctx!.beginPath();
      ctx!.strokeStyle = "oklch(0.58 0.14 0 / 0.5)";
      ctx!.lineWidth = 1.5;

      const points = 120;
      for (let i = 0; i < points; i++) {
        const x = cx + (i / points) * width;
        const phase = (i / points) * Math.PI * 4 + t * 2;

        let y = cy;
        // QRS complex simulation
        const pos = ((i / points + t * 0.05) % 1);
        if (pos > 0.4 && pos < 0.42) {
          y = cy - height * 0.3;
        } else if (pos > 0.42 && pos < 0.44) {
          y = cy + height * 0.8;
        } else if (pos > 0.44 && pos < 0.46) {
          y = cy - height * 0.2;
        } else if (pos > 0.46 && pos < 0.48) {
          y = cy;
        } else {
          y = cy + Math.sin(phase) * height * 0.05;
        }

        if (i === 0) ctx!.moveTo(x, y);
        else ctx!.lineTo(x, y);
      }
      ctx!.stroke();
    }

    function drawCircularGauge(cx: number, cy: number, radius: number, value: number, maxVal: number, color: string) {
      const angle = (value / maxVal) * Math.PI * 1.5;

      // Background arc
      ctx!.beginPath();
      ctx!.arc(cx, cy, radius, -Math.PI * 0.75, Math.PI * 0.75);
      ctx!.strokeStyle = "oklch(0.90 0.008 350)";
      ctx!.lineWidth = 2;
      ctx!.stroke();

      // Value arc
      ctx!.beginPath();
      ctx!.arc(cx, cy, radius, -Math.PI * 0.75, -Math.PI * 0.75 + angle);
      ctx!.strokeStyle = color;
      ctx!.lineWidth = 2;
      ctx!.stroke();
    }

    function draw() {
      const cw = w();
      const ch = h();
      ctx!.clearRect(0, 0, cw, ch);

      // Background grid (subtle)
      ctx!.strokeStyle = "oklch(0.90 0.008 350 / 0.5)";
      ctx!.lineWidth = 0.5;
      for (let x = 0; x < cw; x += 20) {
        ctx!.beginPath();
        ctx!.moveTo(x, 0);
        ctx!.lineTo(x, ch);
        ctx!.stroke();
      }
      for (let y = 0; y < ch; y += 20) {
        ctx!.beginPath();
        ctx!.moveTo(0, y);
        ctx!.lineTo(cw, y);
        ctx!.stroke();
      }

      // Heartbeat waveform
      drawHeartbeat(0, ch * 0.35, cw, ch * 0.15, time);

      // Respiration wave
      ctx!.beginPath();
      ctx!.strokeStyle = "oklch(0.50 0.16 325 / 0.3)";
      ctx!.lineWidth = 1;
      for (let i = 0; i < 120; i++) {
        const x = (i / 120) * cw;
        const y = ch * 0.65 + Math.sin(i * 0.08 + time * 1.5) * ch * 0.06;
        if (i === 0) ctx!.moveTo(x, y);
        else ctx!.lineTo(x, y);
      }
      ctx!.stroke();

      // Circular gauges
      const gaugeY = ch * 0.82;
      const gaugeSpacing = cw / 4;
      vitals.forEach((v, i) => {
        const gx = gaugeSpacing * (i + 1);
        drawCircularGauge(gx, gaugeY, 18, v.value, v.value * 1.3, v.color);

        // Value text
        ctx!.fillStyle = "oklch(0.38 0.005 350)";
        ctx!.font = "600 11px Rajdhani, sans-serif";
        ctx!.textAlign = "center";
        ctx!.fillText(`${v.value}`, gx, gaugeY + 4);

        // Label
        ctx!.fillStyle = "oklch(0.60 0.008 350)";
        ctx!.font = "10px 'JetBrains Mono', monospace";
        ctx!.fillText(v.label, gx, gaugeY + 28);
      });

      // Cross markers
      ctx!.strokeStyle = "oklch(0.80 0.01 350)";
      ctx!.lineWidth = 0.5;
      [[cw * 0.1, ch * 0.1], [cw * 0.9, ch * 0.15], [cw * 0.85, ch * 0.5]].forEach(([x, y]) => {
        ctx!.beginPath();
        ctx!.moveTo(x - 3, y);
        ctx!.lineTo(x + 3, y);
        ctx!.stroke();
        ctx!.beginPath();
        ctx!.moveTo(x, y - 3);
        ctx!.lineTo(x, y + 3);
        ctx!.stroke();
      });

      time += 0.02;
      requestAnimationFrame(draw);
    }

    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        observer.disconnect();
        draw();
      }
    });
    observer.observe(container);

    window.addEventListener("resize", resize, { passive: true });
  });
</script>
