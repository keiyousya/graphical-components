---
interface Props {
  size?: "sm" | "md" | "lg";
  class?: string;
}

const {
  size = "md",
  class: className = "",
} = Astro.props;

const sizes = {
  sm: "h-48",
  md: "h-64",
  lg: "h-80",
};
---

<div class:list={["watchme-monitor relative overflow-hidden bg-mist-50", sizes[size], className]}>
  <canvas class="watchme-canvas w-full h-full"></canvas>
  <!-- Overlay data -->
  <div class="absolute top-3 left-3 font-mono text-[9px] text-hml-400/70 tracking-wider">
    <div>LifeSync v3.2.1</div>
    <div class="mt-0.5">BIOSYNC: <span class="text-vita-500">ACTIVE</span></div>
  </div>
  <div class="absolute bottom-3 right-3 font-mono text-[9px] text-hml-400/50 tracking-wider">
    &lt;body&gt; monitor
  </div>
</div>

<script>
  document.querySelectorAll<HTMLDivElement>(".watchme-monitor").forEach((container) => {
    const canvas = container.querySelector<HTMLCanvasElement>(".watchme-canvas");
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const resize = () => {
      const rect = container.getBoundingClientRect();
      canvas.width = rect.width * devicePixelRatio;
      canvas.height = rect.height * devicePixelRatio;
      ctx.scale(devicePixelRatio, devicePixelRatio);
    };
    resize();

    const w = () => canvas.width / devicePixelRatio;
    const h = () => canvas.height / devicePixelRatio;

    let time = 0;

    // -------------------------------------------------------
    // ECG waveform generator (Lead II morphology)
    // Flat isoelectric baseline with P, QRS, T waves
    // -------------------------------------------------------
    function ecgSample(phase: number): number {
      // phase: 0..1 = one cardiac cycle
      // Returns voltage as fraction of amplitude (-0.2 .. 1.0)
      const p = phase % 1;

      // P wave: small upward deflection (atrial depolarization)
      // ~0.06-0.12 in cycle
      if (p >= 0.06 && p < 0.12) {
        const t = (p - 0.06) / 0.06;
        return Math.sin(t * Math.PI) * 0.12;
      }

      // PR segment: flat
      // 0.12 - 0.16

      // Q wave: small downward deflection
      if (p >= 0.16 && p < 0.18) {
        const t = (p - 0.16) / 0.02;
        return -Math.sin(t * Math.PI) * 0.08;
      }

      // R wave: tall sharp upward spike (ventricular depolarization)
      if (p >= 0.18 && p < 0.22) {
        const t = (p - 0.18) / 0.04;
        return Math.sin(t * Math.PI) * 1.0;
      }

      // S wave: sharp downward deflection
      if (p >= 0.22 && p < 0.25) {
        const t = (p - 0.22) / 0.03;
        return -Math.sin(t * Math.PI) * 0.2;
      }

      // ST segment: flat (return to baseline)
      // 0.25 - 0.32

      // T wave: broad upward deflection (ventricular repolarization)
      if (p >= 0.32 && p < 0.44) {
        const t = (p - 0.32) / 0.12;
        return Math.sin(t * Math.PI) * 0.25;
      }

      // Isoelectric baseline (flat)
      return 0;
    }

    // -------------------------------------------------------
    // SpO2 plethysmograph waveform
    // Sharp systolic upstroke, dicrotic notch, diastolic runoff
    // -------------------------------------------------------
    function spo2Sample(phase: number): number {
      const p = phase % 1;

      // Systolic upstroke: sharp rise
      if (p >= 0.0 && p < 0.12) {
        const t = p / 0.12;
        return Math.pow(t, 1.5);
      }

      // Systolic peak & initial descent
      if (p >= 0.12 && p < 0.25) {
        const t = (p - 0.12) / 0.13;
        return 1.0 - t * 0.35;
      }

      // Dicrotic notch (small dip then small bump)
      if (p >= 0.25 && p < 0.30) {
        const t = (p - 0.25) / 0.05;
        return 0.65 - Math.sin(t * Math.PI) * 0.08;
      }

      // Dicrotic wave (small secondary peak)
      if (p >= 0.30 && p < 0.38) {
        const t = (p - 0.30) / 0.08;
        return 0.65 + Math.sin(t * Math.PI) * 0.06 - t * 0.15;
      }

      // Diastolic runoff: gradual exponential decay
      if (p >= 0.38 && p < 0.85) {
        const t = (p - 0.38) / 0.47;
        return 0.56 * Math.exp(-t * 2.5);
      }

      // Baseline before next beat
      return 0.56 * Math.exp(-2.5) * (1 - ((p - 0.85) / 0.15));
    }

    // -------------------------------------------------------
    // Respiration waveform (smooth sine-like)
    // -------------------------------------------------------
    function respSample(phase: number): number {
      return Math.sin(phase * Math.PI * 2);
    }

    // -------------------------------------------------------
    // Drawing functions
    // -------------------------------------------------------
    function drawWaveform(
      ox: number, oy: number, width: number, amplitude: number,
      sampleFn: (phase: number) => number,
      cyclesVisible: number, speed: number,
      color: string, lineWidth: number
    ) {
      ctx!.beginPath();
      ctx!.strokeStyle = color;
      ctx!.lineWidth = lineWidth;

      const points = Math.floor(width / 1.5);
      for (let i = 0; i < points; i++) {
        const x = ox + (i / points) * width;
        const phase = (i / points) * cyclesVisible + time * speed;
        const val = sampleFn(phase);
        const y = oy - val * amplitude;

        if (i === 0) ctx!.moveTo(x, y);
        else ctx!.lineTo(x, y);
      }
      ctx!.stroke();
    }

    function drawLabel(
      x: number, y: number,
      label: string, value: string, unit: string,
      color: string
    ) {
      ctx!.font = "10px 'JetBrains Mono', monospace";
      ctx!.fillStyle = "oklch(0.60 0.008 350)";
      ctx!.textAlign = "left";
      ctx!.fillText(label, x, y);

      ctx!.font = "600 16px Rajdhani, sans-serif";
      ctx!.fillStyle = color;
      ctx!.fillText(value, x, y + 16);

      ctx!.font = "10px 'JetBrains Mono', monospace";
      ctx!.fillStyle = "oklch(0.65 0.008 350)";
      ctx!.fillText(unit, x + ctx!.measureText(value).width + 3, y + 16);
    }

    function draw() {
      const cw = w();
      const ch = h();
      ctx!.clearRect(0, 0, cw, ch);

      // Background grid (5mm-equivalent)
      const gridSmall = 10;
      const gridLarge = 50;

      // Small grid
      ctx!.strokeStyle = "oklch(0.92 0.005 350 / 0.4)";
      ctx!.lineWidth = 0.3;
      for (let x = 0; x < cw; x += gridSmall) {
        ctx!.beginPath(); ctx!.moveTo(x, 0); ctx!.lineTo(x, ch); ctx!.stroke();
      }
      for (let y = 0; y < ch; y += gridSmall) {
        ctx!.beginPath(); ctx!.moveTo(0, y); ctx!.lineTo(cw, y); ctx!.stroke();
      }

      // Large grid
      ctx!.strokeStyle = "oklch(0.88 0.008 350 / 0.5)";
      ctx!.lineWidth = 0.5;
      for (let x = 0; x < cw; x += gridLarge) {
        ctx!.beginPath(); ctx!.moveTo(x, 0); ctx!.lineTo(x, ch); ctx!.stroke();
      }
      for (let y = 0; y < ch; y += gridLarge) {
        ctx!.beginPath(); ctx!.moveTo(0, y); ctx!.lineTo(cw, y); ctx!.stroke();
      }

      const waveX = 70;
      const waveW = cw - 80;

      // --- ECG Lead II ---
      const ecgY = ch * 0.22;
      drawWaveform(
        waveX, ecgY, waveW, ch * 0.12,
        ecgSample, 3.5, 0.12,
        "oklch(0.52 0.12 0 / 0.7)", 1.5
      );
      drawLabel(6, ecgY - ch * 0.1, "II", "72", "bpm", "oklch(0.52 0.12 0)");

      // --- SpO2 Plethysmograph ---
      const spo2Y = ch * 0.52;
      drawWaveform(
        waveX, spo2Y, waveW, ch * 0.1,
        spo2Sample, 3.5, 0.12,
        "oklch(0.50 0.12 325 / 0.5)", 1.3
      );
      drawLabel(6, spo2Y - ch * 0.08, "SpO\u2082", "98", "%", "oklch(0.50 0.12 325)");

      // --- Bottom vitals bar ---
      const barY = ch * 0.92;
      ctx!.fillStyle = "oklch(0.94 0.005 350)";
      ctx!.fillRect(0, barY - 4, cw, ch - barY + 8);
      ctx!.strokeStyle = "oklch(0.88 0.008 350)";
      ctx!.lineWidth = 0.5;
      ctx!.beginPath(); ctx!.moveTo(0, barY - 4); ctx!.lineTo(cw, barY - 4); ctx!.stroke();

      const barItems = [
        { label: "HR", value: "72", unit: "bpm" },
        { label: "BP", value: "120/78", unit: "mmHg" },
        { label: "SpO\u2082", value: "98", unit: "%" },
        { label: "TEMP", value: "36.5", unit: "\u00B0C" },
        { label: "RESP", value: "16", unit: "/min" },
      ];
      const spacing = cw / (barItems.length + 1);
      barItems.forEach((item, i) => {
        const bx = spacing * (i + 1);
        ctx!.textAlign = "center";
        ctx!.font = "9px 'JetBrains Mono', monospace";
        ctx!.fillStyle = "oklch(0.65 0.005 350)";
        ctx!.fillText(item.label, bx, barY + 6);
        ctx!.font = "600 12px Rajdhani, sans-serif";
        ctx!.fillStyle = "oklch(0.40 0.005 350)";
        ctx!.fillText(`${item.value} ${item.unit}`, bx, barY + 19);
      });

      time += 0.015;
      requestAnimationFrame(draw);
    }

    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        observer.disconnect();
        draw();
      }
    });
    observer.observe(container);

    window.addEventListener("resize", resize, { passive: true });
  });
</script>
