---
interface Props {
  size?: "sm" | "md" | "lg";
  label?: string;
  class?: string;
}

const {
  size = "md",
  label,
  class: className = "",
} = Astro.props;

const sizes = {
  sm: { svg: 32, stroke: 2 },
  md: { svg: 48, stroke: 2 },
  lg: { svg: 64, stroke: 2 },
};

const s = sizes[size];
const r = s.svg / 2 - s.stroke - 2;
const circ = 2 * Math.PI * r;
---

<div class:list={["harmony-spinner flex flex-col items-center gap-2", className]}>
  <div class="relative">
    <svg width={s.svg} height={s.svg} viewBox={`0 0 ${s.svg} ${s.svg}`} class="spinner-ring">
      <!-- Track -->
      <circle
        cx={s.svg / 2} cy={s.svg / 2} r={r}
        fill="none"
        stroke="oklch(0.90 0.008 350)"
        stroke-width={s.stroke}
      />
      <!-- Spinner -->
      <circle
        cx={s.svg / 2} cy={s.svg / 2} r={r}
        fill="none"
        stroke="oklch(0.58 0.14 0 / 0.6)"
        stroke-width={s.stroke}
        stroke-dasharray={`${circ * 0.3} ${circ * 0.7}`}
        stroke-linecap="round"
      />
    </svg>
    <!-- Center cross -->
    <div class="absolute inset-0 flex items-center justify-center">
      <span class="text-[8px] text-rose-400/60 select-none">+</span>
    </div>
  </div>
  {label && (
    <span class="font-mono text-[10px] text-ash-400 tracking-[0.1em] uppercase">{label}</span>
  )}
</div>

<style>
  .spinner-ring {
    animation: harmony-spin 2s linear infinite;
  }
  @keyframes harmony-spin {
    to { transform: rotate(360deg); }
  }
</style>
