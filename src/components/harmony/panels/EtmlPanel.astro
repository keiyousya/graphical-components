---
interface Props {
  tag?: string;
  class?: string;
}

const {
  tag = "section",
  class: className = "",
} = Astro.props;
---

<div class:list={["hml-panel relative border border-mist-500/60 bg-mist-50/80 backdrop-blur-sm", className]}>
  <!-- hml header -->
  <div class="border-b border-mist-500/40 px-4 py-2 bg-mist-200/50">
    <span class="font-mono text-[10px] text-hml-400 tracking-wider">
      &lt;{tag}&gt;
    </span>
  </div>

  <!-- Content -->
  <div class="p-5">
    <slot />
  </div>

  <!-- hml footer -->
  <div class="border-t border-mist-500/40 px-4 py-1.5 bg-mist-200/30">
    <span class="font-mono text-[10px] text-hml-300/60 tracking-wider">
      &lt;/{tag}&gt;
    </span>
  </div>
</div>

<style>
  .hml-panel {
    box-shadow: 0 1px 3px oklch(0.50 0.02 350 / 0.06);
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .hml-panel:hover {
    box-shadow: 0 4px 12px oklch(0.58 0.14 0 / 0.06);
    border-color: oklch(0.58 0.14 0 / 0.15);
  }
</style>
