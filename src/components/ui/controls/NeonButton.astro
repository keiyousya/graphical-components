---
interface Props {
  variant?: "default" | "alert" | "danger" | "status" | "holo";
  size?: "sm" | "md" | "lg";
  href?: string;
  class?: string;
}

const {
  variant = "default",
  size = "md",
  href,
  class: className = "",
} = Astro.props;

const Element = href ? "a" : "button";

const colors = {
  default: {
    border: "border-cyber-500",
    text: "text-cyber-300",
    hover: "hover:bg-cyber-500/15 hover:shadow-glow-md hover:text-cyber-200",
    dot: "bg-cyber-500",
  },
  alert: {
    border: "border-alert-500",
    text: "text-alert-300",
    hover: "hover:bg-alert-500/15 hover:shadow-glow-alert hover:text-alert-200",
    dot: "bg-alert-500",
  },
  danger: {
    border: "border-danger-500",
    text: "text-danger-300",
    hover: "hover:bg-danger-500/15 hover:shadow-glow-danger hover:text-danger-200",
    dot: "bg-danger-500",
  },
  status: {
    border: "border-status-500",
    text: "text-status-300",
    hover: "hover:bg-status-500/15 hover:shadow-glow-status hover:text-status-200",
    dot: "bg-status-500",
  },
  holo: {
    border: "border-holo-500",
    text: "text-holo-300",
    hover: "hover:bg-holo-500/15 hover:shadow-glow-holo hover:text-holo-200",
    dot: "bg-holo-500",
  },
};

const sizes = {
  sm: "px-4 py-1.5 text-xs gap-2",
  md: "px-6 py-2.5 text-sm gap-2.5",
  lg: "px-8 py-3.5 text-base gap-3",
};

const c = colors[variant];
---

<Element
  href={href}
  class:list={[
    "neon-btn group relative inline-flex items-center border font-display tracking-widest uppercase transition-all duration-300 cursor-pointer",
    c.border,
    c.text,
    c.hover,
    sizes[size],
    className,
  ]}
>
  <span class:list={["size-1.5 rounded-full animate-pulse-glow", c.dot]}></span>
  <slot />
  <!-- Corner accents -->
  <span class:list={["absolute top-0 left-0 w-2 h-2 border-t border-l transition-colors", c.border]}
  ></span>
  <span
    class:list={["absolute top-0 right-0 w-2 h-2 border-t border-r transition-colors", c.border]}
  ></span>
  <span
    class:list={["absolute bottom-0 left-0 w-2 h-2 border-b border-l transition-colors", c.border]}
  ></span>
  <span
    class:list={["absolute bottom-0 right-0 w-2 h-2 border-b border-r transition-colors", c.border]}
  ></span>
</Element>

<style>
  .neon-btn {
    background: oklch(0.08 0.01 250 / 0.4);
  }
  .neon-btn:active {
    transform: scale(0.97);
  }
</style>
