---
interface Props {
  value: number;
  max?: number;
  label?: string;
  size?: "sm" | "md" | "lg";
  variant?: "default" | "alert" | "danger" | "status";
  class?: string;
}

const {
  value,
  max = 100,
  label,
  size = "md",
  variant = "default",
  class: className = "",
} = Astro.props;

const pct = Math.min(value / max, 1);
const circumference = 2 * Math.PI * 42;
const dashOffset = circumference * (1 - pct);

const sizes = {
  sm: "size-20",
  md: "size-32",
  lg: "size-44",
};

const colors = {
  default: { stroke: "oklch(0.55 0.18 195)", glow: "oklch(0.55 0.18 195 / 0.4)" },
  alert: { stroke: "oklch(0.65 0.20 65)", glow: "oklch(0.65 0.20 65 / 0.4)" },
  danger: { stroke: "oklch(0.55 0.25 25)", glow: "oklch(0.55 0.25 25 / 0.4)" },
  status: { stroke: "oklch(0.65 0.20 155)", glow: "oklch(0.65 0.20 155 / 0.4)" },
};
const c = colors[variant];
---

<div class:list={["progress-arc relative inline-flex items-center justify-center", sizes[size], className]}>
  <svg viewBox="0 0 100 100" class="size-full -rotate-90">
    <!-- Background track -->
    <circle cx="50" cy="50" r="42" fill="none" stroke="oklch(0.55 0.18 195 / 0.08)" stroke-width="3" />
    <!-- Tick marks -->
    {Array.from({ length: 24 }).map((_, i) => (
      <line
        x1="50" y1="4" x2="50" y2="7"
        stroke="oklch(0.55 0.18 195 / 0.15)"
        stroke-width="0.5"
        transform={`rotate(${i * 15} 50 50)`}
      />
    ))}
    <!-- Progress arc -->
    <circle
      cx="50" cy="50" r="42"
      fill="none"
      stroke={c.stroke}
      stroke-width="3"
      stroke-linecap="round"
      stroke-dasharray={circumference}
      stroke-dashoffset={dashOffset}
      style={`filter: drop-shadow(0 0 4px ${c.glow}); transition: stroke-dashoffset 1s ease-out;`}
    />
  </svg>
  <div class="absolute inset-0 flex flex-col items-center justify-center">
    <span class="font-display text-lg text-cyber-200 tabular-nums"
      style="text-shadow: 0 0 10px oklch(0.55 0.18 195 / 0.3);"
    >
      {Math.round(pct * 100)}%
    </span>
    {label && (
      <span class="font-mono text-[8px] text-cyber-600 tracking-widest uppercase">{label}</span>
    )}
  </div>
</div>
