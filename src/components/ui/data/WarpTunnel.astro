---
interface Props {
  size?: "sm" | "md" | "lg";
  color?: string;
  speed?: number;
  class?: string;
}

const {
  size = "md",
  color = "#00d4e5",
  speed = 1,
  class: className = "",
} = Astro.props;

const sizes = {
  sm: "h-40",
  md: "h-64",
  lg: "h-96",
};
---

<div
  class:list={["warp-tunnel relative w-full", sizes[size], className]}
  data-color={color}
  data-speed={speed}
>
  <canvas class="warp-tunnel-canvas absolute inset-0 w-full h-full"></canvas>
  <div class="relative z-10 h-full flex items-center justify-center">
    <slot />
  </div>
</div>

<script>
  import * as THREE from "three";

  document.querySelectorAll<HTMLElement>(".warp-tunnel").forEach((container) => {
    const canvas = container.querySelector<HTMLCanvasElement>(".warp-tunnel-canvas");
    if (!canvas) return;

    const color = container.dataset.color || "#00d4e5";
    const speed = parseFloat(container.dataset.speed || "1");

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(75, 2, 0.1, 1000);
    camera.position.z = 0;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const mainColor = new THREE.Color(color);

    // Tunnel rings
    const ringCount = 40;
    const rings: THREE.Line[] = [];
    for (let i = 0; i < ringCount; i++) {
      const z = -i * 5;
      const radius = 3 + Math.sin(i * 0.3) * 0.5;
      const curve = new THREE.EllipseCurve(0, 0, radius, radius, 0, Math.PI * 2, false, 0);
      const pts = curve.getPoints(i % 4 === 0 ? 6 : 64);
      const geo = new THREE.BufferGeometry().setFromPoints(pts.map(p => new THREE.Vector3(p.x, p.y, z)));
      const mat = new THREE.LineBasicMaterial({
        color: mainColor,
        transparent: true,
        opacity: i % 4 === 0 ? 0.3 : 0.12,
      });
      const ring = new THREE.Line(geo, mat);
      scene.add(ring);
      rings.push(ring);
    }

    // Streaking particles (stars/data)
    const streakCount = 300;
    const streakGeo = new THREE.BufferGeometry();
    const streakPositions = new Float32Array(streakCount * 3);
    const streakVelocities = new Float32Array(streakCount);

    for (let i = 0; i < streakCount; i++) {
      const angle = Math.random() * Math.PI * 2;
      const r = 0.5 + Math.random() * 3;
      streakPositions[i * 3] = Math.cos(angle) * r;
      streakPositions[i * 3 + 1] = Math.sin(angle) * r;
      streakPositions[i * 3 + 2] = -Math.random() * 200;
      streakVelocities[i] = 0.5 + Math.random() * 1.5;
    }
    streakGeo.setAttribute("position", new THREE.BufferAttribute(streakPositions, 3));

    const streakMat = new THREE.PointsMaterial({
      color: mainColor,
      size: 0.06,
      transparent: true,
      opacity: 0.6,
      blending: THREE.AdditiveBlending,
      sizeAttenuation: true,
    });
    scene.add(new THREE.Points(streakGeo, streakMat));

    // Longitudinal lines
    for (let i = 0; i < 12; i++) {
      const angle = (i / 12) * Math.PI * 2;
      const r = 3;
      const pts = [];
      for (let z = 0; z > -200; z -= 5) {
        pts.push(new THREE.Vector3(
          Math.cos(angle + z * 0.002) * (r + Math.sin(z * 0.05) * 0.3),
          Math.sin(angle + z * 0.002) * (r + Math.sin(z * 0.05) * 0.3),
          z
        ));
      }
      const geo = new THREE.BufferGeometry().setFromPoints(pts);
      const mat = new THREE.LineBasicMaterial({
        color: mainColor,
        transparent: true,
        opacity: 0.06,
      });
      scene.add(new THREE.Line(geo, mat));
    }

    function resize() {
      const rect = container.getBoundingClientRect();
      renderer.setSize(rect.width, rect.height);
      camera.aspect = rect.width / rect.height;
      camera.updateProjectionMatrix();
    }

    let time = 0;
    function animate() {
      time += 0.01 * speed;

      // Move streaks forward
      const pos = streakGeo.attributes.position.array as Float32Array;
      for (let i = 0; i < streakCount; i++) {
        pos[i * 3 + 2] += streakVelocities[i] * speed;
        if (pos[i * 3 + 2] > 5) {
          pos[i * 3 + 2] = -200;
          const angle = Math.random() * Math.PI * 2;
          const r = 0.5 + Math.random() * 3;
          pos[i * 3] = Math.cos(angle) * r;
          pos[i * 3 + 1] = Math.sin(angle) * r;
        }
      }
      streakGeo.attributes.position.needsUpdate = true;

      // Rotate tunnel slightly
      scene.rotation.z = Math.sin(time * 0.3) * 0.05;

      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    }

    resize();
    animate();
    const ro = new ResizeObserver(() => resize());
    ro.observe(container);
  });
</script>
