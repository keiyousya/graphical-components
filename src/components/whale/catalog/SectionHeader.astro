---
interface Props {
  title: string;
  tag?: string;
  class?: string;
}

const { title, tag, class: className = "" } = Astro.props;
---

<div class:list={["flex items-center gap-4 mb-8", className]}>
  <div class="flex items-center gap-2">
    <span class="size-1.5 rounded-full bg-ink-400 animate-whale-pulse"></span>
    {tag && <span class="font-mono text-[10px] text-ink-300 uppercase tracking-[0.2em]">{tag}</span>}
  </div>
  <h2 class="font-display text-lg tracking-[0.1em] uppercase text-ink-700">{title}</h2>
  <div class="flex-1 h-px bg-gradient-to-r from-ink-200/40 to-transparent"></div>
</div>
