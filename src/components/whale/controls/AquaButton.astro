---
interface Props {
  variant?: "default" | "dark" | "subtle";
  size?: "sm" | "md" | "lg";
  href?: string;
  class?: string;
}

const {
  variant = "default",
  size = "md",
  href,
  class: className = "",
} = Astro.props;

const variantStyles = {
  default: "border-ink-400/40 text-ink-600 hover:bg-ink-100/30 hover:border-ink-500/50",
  dark: "border-ink-600/50 text-ink-700 hover:bg-ink-200/30 hover:border-ink-700/60",
  subtle: "border-ink-200/30 text-ink-400 hover:bg-ink-100/20 hover:border-ink-300/40",
};

const sizeStyles = {
  sm: "px-3 py-1 text-xs",
  md: "px-5 py-2 text-sm",
  lg: "px-7 py-3 text-base",
};

const Tag = href ? "a" : "button";
---

<Tag
  href={href}
  class:list={[
    "inline-flex items-center gap-2 border font-ui tracking-wider uppercase transition-all duration-300",
    variantStyles[variant],
    sizeStyles[size],
    className,
  ]}
>
  <slot />
</Tag>
