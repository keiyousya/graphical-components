---
interface Props {
  size?: "sm" | "md" | "lg" | "xl";
  class?: string;
}

const {
  size = "lg",
  class: className = "",
} = Astro.props;

const sizes = {
  sm: "h-48",
  md: "h-64",
  lg: "h-80",
  xl: "h-[32rem]",
};
---

<div
  class:list={["holo-whale relative w-full", sizes[size], className]}
>
  <canvas class="whale-canvas absolute inset-0 w-full h-full"></canvas>
</div>

<script>
  import * as THREE from "three";
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
  import { DRACOLoader } from "three/addons/loaders/DRACOLoader.js";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";

  const BASE_URL = import.meta.env.BASE_URL.replace(/\/$/, "");

  document.querySelectorAll<HTMLElement>(".holo-whale").forEach((container) => {
    const canvas = container.querySelector<HTMLCanvasElement>(".whale-canvas");
    if (!canvas) return;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(50, 2, 0.1, 200);
    camera.position.set(0, 1, 12);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    const wireColor = new THREE.Color(0x222222);
    const pointColor = new THREE.Color(0x000000);

    const whaleGroup = new THREE.Group();
    scene.add(whaleGroup);

    // Swimming animation data (body + eyes only)
    interface SwimData {
      geo: THREE.BufferGeometry;
      origPositions: Float32Array;
    }
    const swimTargets: SwimData[] = [];

    // Barnacle data (move as whole objects)
    interface BarnacleData {
      obj: THREE.Object3D; // parent object (pCylinder)
      origPos: THREE.Vector3; // original world position
      bodyT: number; // normalized position along body (0=head, 1=tail)
      bodyYNorm: number; // normalized vertical position (0=bottom, 1=top)
      bodyZNorm: number; // normalized lateral position (0..1)
    }
    const barnacles: BarnacleData[] = [];

    // Global body ranges (from body mesh only)
    let bodyXMin = Infinity, bodyXMax = -Infinity;
    let bodyYMin = Infinity, bodyYMax = -Infinity;
    let bodyZMin = Infinity, bodyZMax = -Infinity;

    // === Load whale GLB model ===
    const dracoLoader = new DRACOLoader();
    dracoLoader.setDecoderPath("https://www.gstatic.com/draco/versioned/decoders/1.5.7/");
    const loader = new GLTFLoader();
    loader.setDRACOLoader(dracoLoader);
    loader.load(`${BASE_URL}/models/humbpack-whale.glb`, (gltf) => {
      const model = gltf.scene;

      // Center and scale
      const box = new THREE.Box3().setFromObject(model);
      const center = box.getCenter(new THREE.Vector3());
      const bSize = box.getSize(new THREE.Vector3());
      const maxDim = Math.max(bSize.x, bSize.y, bSize.z);
      const scale = 10 / maxDim;

      model.position.sub(center);
      model.scale.setScalar(scale);

      // No rotation needed — model is already along X axis

      // Collect meshes first (avoid modifying tree during traverse)
      const meshes: THREE.Mesh[] = [];
      model.traverse((child) => {
        if (child instanceof THREE.Mesh) meshes.push(child);
      });

      // Separate body/eye meshes from barnacles
      const bodyMeshes: THREE.Mesh[] = [];
      const barnacleMeshes: THREE.Mesh[] = [];
      for (const mesh of meshes) {
        if (mesh.name.includes("hujitubo")) {
          barnacleMeshes.push(mesh);
        } else {
          bodyMeshes.push(mesh);
        }
      }

      // Compute body ranges from body mesh only
      for (const mesh of bodyMeshes) {
        const positions = mesh.geometry.getAttribute("position");
        for (let i = 0; i < positions.count; i++) {
          const x = positions.getX(i);
          const y = positions.getY(i);
          const z = positions.getZ(i);
          if (x < bodyXMin) bodyXMin = x;
          if (x > bodyXMax) bodyXMax = x;
          if (y < bodyYMin) bodyYMin = y;
          if (y > bodyYMax) bodyYMax = y;
          if (z < bodyZMin) bodyZMin = z;
          if (z > bodyZMax) bodyZMax = z;
        }
      }

      // Setup body meshes for vertex deformation
      for (const mesh of bodyMeshes) {
        const geo = mesh.geometry;
        const positions = geo.getAttribute("position");
        const origPos = new Float32Array(positions.array.length);
        origPos.set(positions.array as Float32Array);

        swimTargets.push({ geo, origPositions: origPos });

        mesh.material = new THREE.MeshBasicMaterial({
          color: 0xf5f5f5,
          polygonOffset: true,
          polygonOffsetFactor: 1,
          polygonOffsetUnits: 1,
        });

        const wireMesh = new THREE.Mesh(geo, new THREE.MeshBasicMaterial({
          color: wireColor,
          wireframe: true,
          transparent: true,
          opacity: 0.3,
        }));
        wireMesh.position.copy(mesh.position);
        wireMesh.rotation.copy(mesh.rotation);
        wireMesh.scale.copy(mesh.scale);
        mesh.parent!.add(wireMesh);
      }

      // Setup barnacles — store world position and compute body-relative coords
      const bodyXRange = bodyXMax - bodyXMin;
      const bodyYRange = bodyYMax - bodyYMin;
      const bodyZRange = bodyZMax - bodyZMin;
      for (const mesh of barnacleMeshes) {
        // Style barnacles the same way
        mesh.material = new THREE.MeshBasicMaterial({
          color: 0xf5f5f5,
          polygonOffset: true,
          polygonOffsetFactor: 1,
          polygonOffsetUnits: 1,
        });
        const wireMesh = new THREE.Mesh(mesh.geometry, new THREE.MeshBasicMaterial({
          color: wireColor,
          wireframe: true,
          transparent: true,
          opacity: 0.3,
        }));
        wireMesh.position.copy(mesh.position);
        wireMesh.rotation.copy(mesh.rotation);
        wireMesh.scale.copy(mesh.scale);
        mesh.parent!.add(wireMesh);

        // Use the parent object (pCylinder) for whole-object movement
        const parentObj = mesh.parent!;
        // parentObj.position is in model-local space (same coord system as body vertices)
        const lp = parentObj.position;
        const bT = (lp.x - bodyXMin) / bodyXRange;
        const bY = (lp.y - bodyYMin) / bodyYRange;
        const bZ = (lp.z - bodyZMin) / bodyZRange;
        barnacles.push({
          obj: parentObj,
          origPos: lp.clone(),
          bodyT: bT,
          bodyYNorm: bY,
          bodyZNorm: bZ,
        });
      }

      whaleGroup.add(model);

      console.log("Whale loaded:", {
        bodyMeshes: bodyMeshes.length,
        barnacles: barnacles.length,
        bodyXRange: bodyXRange,
        bodyZRange: bodyZRange,
      });
    });

    // === Orbit controls (360° rotation) ===
    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.enableZoom = true;
    controls.enablePan = false;
    controls.minDistance = 4;
    controls.maxDistance = 25;

    // === Resize ===
    function resize() {
      const r = container.getBoundingClientRect();
      renderer.setSize(r.width, r.height);
      camera.aspect = r.width / r.height;
      camera.updateProjectionMatrix();
    }

    // === Animation ===
    let time = 0;
    function animate() {
      time += 0.01;

      // Gentle floating motion
      whaleGroup.position.y = Math.sin(time * 0.5) * 0.15;

      controls.update();

      // Swimming vertex deformation (dolphin kick + fin movement)
      const bodyXRange = bodyXMax - bodyXMin;
      const bodyYRange = bodyYMax - bodyYMin;
      const bodyZRange = bodyZMax - bodyZMin;
      const amp = bodyXRange * 0.04;

      for (const sd of swimTargets) {
        const positions = sd.geo.getAttribute("position") as THREE.BufferAttribute;

        for (let i = 0; i < positions.count; i++) {
          const origX = sd.origPositions[i * 3];
          const origY = sd.origPositions[i * 3 + 1];
          const origZ = sd.origPositions[i * 3 + 2];

          // Normalize along body using global range (0 = head, 1 = tail)
          const t = (origX - bodyXMin) / bodyXRange;

          // === Dolphin kick (tail half only, t > 0.35) ===
          const phase = time * 2.5 - t * 5.0;
          const wave = Math.sin(phase);

          const tailStart = 0.25;
          const tailT = t > tailStart ? (t - tailStart) / (1 - tailStart) : 0;

          const baseAmplitude = tailT * tailT * tailT * amp;

          const rearFactor = tailT > 0 ? Math.pow(tailT, 1.5) : 0;
          const downPower = Math.min(wave, 0) * rearFactor * amp * 0.5;

          const tailTip = tailT > 0.6 ? Math.pow((tailT - 0.6) / 0.4, 2) : 0;
          const upWhip = Math.max(wave, 0) * tailTip * amp * 0.6;

          const tailWave = wave * baseAmplitude + downPower + upWhip;
          let newY = origY + tailWave;

          // === Pectoral fin swing (root-to-tip axis rotation with directional phase) ===
          const zNorm = (origZ - bodyZMin) / bodyZRange;
          const yNorm = (origY - bodyYMin) / bodyYRange;
          const lateralExtent = Math.abs(zNorm - 0.5) * 2; // 0=center, 1=tip
          const finThreshold = 0.35;
          const isFinArea = t > 0.2 && t < 0.55 && lateralExtent > finThreshold;
          if (isFinArea) {
            const tipFactor = (lateralExtent - finThreshold) / (1 - finThreshold);
            // Phase delay: front→back (along t) and bottom→top (along yNorm)
            const finT = (t - 0.2) / (0.55 - 0.2); // 0=front, 1=back
            const phaseDelay = finT * 2.0 + yNorm * 1.5;
            const flapWave = Math.sin(time * 2.0 - phaseDelay);
            const side = zNorm > 0.5 ? 1 : -1;
            const flapAmp = Math.pow(tipFactor, 1.3) * amp * 0.9;
            const outwardBias = flapAmp * 0.5 * side;
            const newZ = origZ + outwardBias + flapWave * flapAmp * side;
            positions.setZ(i, newZ);
            const liftAmp = Math.pow(tipFactor, 1.7) * amp * 0.25;
            newY += Math.max(flapWave, 0) * liftAmp;
          }

          positions.setY(i, newY);
        }
        positions.needsUpdate = true;
      }

      // Move barnacles to match body deformation
      for (const bd of barnacles) {
        const t = bd.bodyT;
        const origPos = bd.origPos;

        // Same dolphin kick calculation as body vertices
        const phase = time * 2.5 - t * 5.0;
        const wave = Math.sin(phase);

        const tailStart = 0.25;
        const tailT = t > tailStart ? (t - tailStart) / (1 - tailStart) : 0;
        const baseAmplitude = tailT * tailT * tailT * amp;
        const rearFactor = tailT > 0 ? Math.pow(tailT, 1.5) : 0;
        const downPower = Math.min(wave, 0) * rearFactor * amp * 0.5;
        const tailTip = tailT > 0.6 ? Math.pow((tailT - 0.6) / 0.4, 2) : 0;
        const upWhip = Math.max(wave, 0) * tailTip * amp * 0.6;
        const tailWave = wave * baseAmplitude + downPower + upWhip;

        let newY = origPos.y + tailWave;
        let newZ = origPos.z;

        // Pectoral fin swing for barnacles on fins
        const lateralExtent = Math.abs(bd.bodyZNorm - 0.5) * 2;
        const finThreshold = 0.35;
        const isFinArea = t > 0.2 && t < 0.55 && lateralExtent > finThreshold;
        if (isFinArea) {
          const tipFactor = (lateralExtent - finThreshold) / (1 - finThreshold);
          const finT = (t - 0.2) / (0.55 - 0.2);
          const phaseDelay = finT * 2.0 + bd.bodyYNorm * 1.5;
          const flapWave = Math.sin(time * 2.0 - phaseDelay);
          const side = bd.bodyZNorm > 0.5 ? 1 : -1;
          const flapAmp = Math.pow(tipFactor, 1.3) * amp * 0.9;
          const outwardBias = flapAmp * 0.5 * side;
          newZ = origPos.z + outwardBias + flapWave * flapAmp * side;
          const liftAmp = Math.pow(tipFactor, 1.7) * amp * 0.25;
          newY += Math.max(flapWave, 0) * liftAmp;
        }

        bd.obj.position.y = newY;
        bd.obj.position.z = newZ;
      }

      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    }

    resize();
    animate();
    const resizeObserver = new ResizeObserver(() => resize());
    resizeObserver.observe(container);
  });
</script>
