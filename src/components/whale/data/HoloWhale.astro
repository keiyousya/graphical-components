---
interface Props {
  size?: "sm" | "md" | "lg" | "xl";
  class?: string;
}

const {
  size = "lg",
  class: className = "",
} = Astro.props;

const sizes = {
  sm: "h-48",
  md: "h-64",
  lg: "h-80",
  xl: "h-[32rem]",
};
---

<div
  class:list={["holo-whale relative w-full", sizes[size], className]}
>
  <canvas class="whale-canvas absolute inset-0 w-full h-full"></canvas>
</div>

<script>
  import * as THREE from "three";
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
  import { EffectComposer } from "three/addons/postprocessing/EffectComposer.js";
  import { RenderPass } from "three/addons/postprocessing/RenderPass.js";
  import { UnrealBloomPass } from "three/addons/postprocessing/UnrealBloomPass.js";

  const BASE_URL = import.meta.env.BASE_URL.replace(/\/$/, "");

  document.querySelectorAll<HTMLElement>(".holo-whale").forEach((container) => {
    const canvas = container.querySelector<HTMLCanvasElement>(".whale-canvas");
    if (!canvas) return;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(50, 2, 0.1, 200);
    camera.position.set(0, -5, 7);
    camera.lookAt(0, -3, 0);

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.2;

    // === Post-processing bloom ===
    const rect = container.getBoundingClientRect();
    const composer = new EffectComposer(renderer);
    composer.addPass(new RenderPass(scene, camera));

    const bloomPass = new UnrealBloomPass(
      new THREE.Vector2(rect.width, rect.height),
      0.6,   // strength
      0.3,   // radius
      0.4    // threshold
    );
    composer.addPass(bloomPass);

    const holoCyan = new THREE.Color(0x55ccee);
    const holoBlue = new THREE.Color(0x3399cc);
    const holoWhite = new THREE.Color(0x99eeff);

    const whaleGroup = new THREE.Group();
    scene.add(whaleGroup);

    // Swimming animation data
    interface SwimData {
      geo: THREE.BufferGeometry;
      origPositions: Float32Array;
      zMin: number;
      zRange: number;
      xMin: number;
      xRange: number;
    }
    const swimTargets: SwimData[] = [];

    // === Load whale GLB model ===
    const loader = new GLTFLoader();
    loader.load(`${BASE_URL}/models/whale.glb`, (gltf) => {
      const model = gltf.scene;

      // Center and scale
      const box = new THREE.Box3().setFromObject(model);
      const center = box.getCenter(new THREE.Vector3());
      const bSize = box.getSize(new THREE.Vector3());
      const maxDim = Math.max(bSize.x, bSize.y, bSize.z);
      const scale = 10 / maxDim;

      model.position.sub(center);
      model.scale.setScalar(scale);

      // Rotate so the whale faces sideways (Z-axis model → X-axis view)
      model.rotation.y = Math.PI / 2;

      model.traverse((child) => {
        if (child instanceof THREE.Mesh) {
          const geo = child.geometry;

          // Store original positions for swimming deformation
          const positions = geo.getAttribute("position");
          const origPos = new Float32Array(positions.array.length);
          origPos.set(positions.array as Float32Array);

          // Compute Z range (body length axis) and X range (width for fin detection)
          let zMin = Infinity, zMax = -Infinity;
          let xMin = Infinity, xMax = -Infinity;
          for (let i = 0; i < positions.count; i++) {
            const z = positions.getZ(i);
            const x = positions.getX(i);
            if (z < zMin) zMin = z;
            if (z > zMax) zMax = z;
            if (x < xMin) xMin = x;
            if (x > xMax) xMax = x;
          }

          swimTargets.push({
            geo,
            origPositions: origPos,
            zMin,
            zRange: zMax - zMin,
            xMin,
            xRange: xMax - xMin,
          });

          // Wireframe body
          child.material = new THREE.MeshBasicMaterial({
            color: holoCyan,
            wireframe: true,
            transparent: true,
            opacity: 0.15,
          });

          // Vertex points (shares geometry — will animate together)
          child.add(new THREE.Points(geo, new THREE.PointsMaterial({
            color: holoWhite,
            size: 0.06,
            transparent: true,
            opacity: 0.6,
            blending: THREE.AdditiveBlending,
            sizeAttenuation: true,
          })));
        }
      });

      whaleGroup.add(model);
    });

    // === Mouse interaction ===
    let mouseX = 0, mouseY = 0;
    container.addEventListener("mousemove", (e) => {
      const r = container.getBoundingClientRect();
      mouseX = ((e.clientX - r.left) / r.width - 0.5) * 2;
      mouseY = ((e.clientY - r.top) / r.height - 0.5) * 2;
    });
    container.addEventListener("mouseleave", () => {
      mouseX = 0;
      mouseY = 0;
    });

    // === Resize ===
    function resize() {
      const r = container.getBoundingClientRect();
      renderer.setSize(r.width, r.height);
      composer.setSize(r.width, r.height);
      camera.aspect = r.width / r.height;
      camera.updateProjectionMatrix();
    }

    // === Animation ===
    let time = 0;
    function animate() {
      time += 0.01;

      // Whale body drift
      whaleGroup.rotation.y += (0.3 + mouseX * 0.5 - whaleGroup.rotation.y) * 0.02;
      whaleGroup.rotation.x += (mouseY * 0.15 - whaleGroup.rotation.x) * 0.02;
      whaleGroup.position.y = Math.sin(time * 0.5) * 0.3;
      whaleGroup.position.x = Math.sin(time * 0.3) * 0.15;
      whaleGroup.rotation.z = Math.sin(time * 0.4) * 0.03;

      // Swimming vertex deformation (dolphin kick + fin movement)
      for (const sd of swimTargets) {
        const positions = sd.geo.getAttribute("position") as THREE.BufferAttribute;
        for (let i = 0; i < positions.count; i++) {
          const origZ = sd.origPositions[i * 3 + 2]; // body length axis
          const origY = sd.origPositions[i * 3 + 1]; // vertical
          const origX = sd.origPositions[i * 3];      // width

          // Normalize Z position along body (0 = head, 1 = tail)
          const t = 1 - (origZ - sd.zMin) / sd.zRange;

          // === Dolphin kick (propagating wave with large phase delay) ===
          // Large phase offset (t * 6.0) creates visible wave propagation head→tail
          const phase = time * 2.5 - t * 6.0;
          const wave = Math.sin(phase);

          // Base amplitude: cubic increase toward tail (gentler)
          const baseAmplitude = t * t * t * 0.9;

          // Downstroke power: rear body (t>0.3) drops together
          const rearFactor = t > 0.3 ? Math.pow((t - 0.3) / 0.7, 1.5) : 0;
          const downPower = Math.min(wave, 0) * rearFactor * 1.2;

          // Upstroke: tail tip (t>0.7) whips up sharply
          const tailTip = t > 0.7 ? Math.pow((t - 0.7) / 0.3, 2) : 0;
          const upWhip = Math.max(wave, 0) * tailTip * 1.4;

          const tailWave = wave * baseAmplitude + downPower + upWhip;
          let newY = origY + tailWave;

          // === Pectoral fin flapping (phase delay from root to tip) ===
          const xNorm = (origX - sd.xMin) / sd.xRange;
          const lateralExtent = Math.abs(xNorm - 0.5) * 2; // 0=center, 1=tip
          const isFinArea = t > 0.2 && t < 0.55 && lateralExtent > 0.35;
          if (isFinArea) {
            // Phase delays from root→tip for fluid wing motion
            const tipFactor = Math.pow((lateralExtent - 0.35) / 0.65, 1.3);
            const finPhase = Math.sin(time * 3.0 - tipFactor * 2.5);
            // Amplitude grows toward tip
            const flapDown = Math.min(finPhase, 0) * tipFactor * 1.2;
            const flapUp = Math.max(finPhase, 0) * tipFactor * 0.8;
            newY += flapDown + flapUp;
            // Forward/back sweep with same phase delay
            const sweep = Math.cos(time * 3.0 - tipFactor * 2.5) * tipFactor * 0.25;
            positions.setZ(i, origZ + sweep);
          }

          positions.setY(i, newY);

          // === Body undulation (lateral S-wave) ===
          const bodyUndulation = Math.sin(time * 2.5 - t * 4.0) * t * t * 0.25;
          positions.setX(i, origX + bodyUndulation);
        }
        positions.needsUpdate = true;
      }

      composer.render();
      requestAnimationFrame(animate);
    }

    resize();
    animate();
    const resizeObserver = new ResizeObserver(() => resize());
    resizeObserver.observe(container);
  });
</script>
