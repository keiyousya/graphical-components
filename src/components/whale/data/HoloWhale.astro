---
interface Props {
  size?: "sm" | "md" | "lg" | "xl";
  class?: string;
}

const {
  size = "lg",
  class: className = "",
} = Astro.props;

const sizes = {
  sm: "h-48",
  md: "h-64",
  lg: "h-80",
  xl: "h-[32rem]",
};
---

<div
  class:list={["holo-whale relative w-full", sizes[size], className]}
>
  <canvas class="whale-canvas absolute inset-0 w-full h-full"></canvas>
</div>

<script>
  import * as THREE from "three";
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";

  const BASE_URL = import.meta.env.BASE_URL.replace(/\/$/, "");

  document.querySelectorAll<HTMLElement>(".holo-whale").forEach((container) => {
    const canvas = container.querySelector<HTMLCanvasElement>(".whale-canvas");
    if (!canvas) return;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(50, 2, 0.1, 200);
    camera.position.set(0, 1, 12);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    const wireColor = new THREE.Color(0x222222);
    const pointColor = new THREE.Color(0x000000);

    const whaleGroup = new THREE.Group();
    scene.add(whaleGroup);

    // Swimming animation data
    interface SwimData {
      geo: THREE.BufferGeometry;
      origPositions: Float32Array;
      zMin: number;
      zRange: number;
      xMin: number;
      xRange: number;
    }
    const swimTargets: SwimData[] = [];

    // === Load whale GLB model ===
    const loader = new GLTFLoader();
    loader.load(`${BASE_URL}/models/humbpack-whale-st.glb`, (gltf) => {
      const model = gltf.scene;

      // Center and scale
      const box = new THREE.Box3().setFromObject(model);
      const center = box.getCenter(new THREE.Vector3());
      const bSize = box.getSize(new THREE.Vector3());
      const maxDim = Math.max(bSize.x, bSize.y, bSize.z);
      const scale = 10 / maxDim;

      model.position.sub(center);
      model.scale.setScalar(scale);

      // No rotation needed — model is already along X axis

      // Collect meshes first (avoid modifying tree during traverse)
      const meshes: THREE.Mesh[] = [];
      model.traverse((child) => {
        if (child instanceof THREE.Mesh) meshes.push(child);
      });

      for (const mesh of meshes) {
        const geo = mesh.geometry;

        // Store original positions for swimming deformation
        const positions = geo.getAttribute("position");
        const origPos = new Float32Array(positions.array.length);
        origPos.set(positions.array as Float32Array);

        // Compute X range (body length axis) and Z range (width for fin detection)
        let xMin = Infinity, xMax = -Infinity;
        let zMin = Infinity, zMax = -Infinity;
        for (let i = 0; i < positions.count; i++) {
          const x = positions.getX(i);
          const z = positions.getZ(i);
          if (x < xMin) xMin = x;
          if (x > xMax) xMax = x;
          if (z < zMin) zMin = z;
          if (z > zMax) zMax = z;
        }

        swimTargets.push({
          geo,
          origPositions: origPos,
          zMin: xMin,
          zRange: xMax - xMin,
          xMin: zMin,
          xRange: zMax - zMin,
        });

        // Solid surface (hides back-face lines)
        mesh.material = new THREE.MeshBasicMaterial({
          color: 0xf5f5f5,
          polygonOffset: true,
          polygonOffsetFactor: 1,
          polygonOffsetUnits: 1,
        });

        // Wireframe overlay added to parent (not mesh itself)
        const wireMesh = new THREE.Mesh(geo, new THREE.MeshBasicMaterial({
          color: wireColor,
          wireframe: true,
          transparent: true,
          opacity: 0.3,
        }));
        wireMesh.position.copy(mesh.position);
        wireMesh.rotation.copy(mesh.rotation);
        wireMesh.scale.copy(mesh.scale);
        mesh.parent!.add(wireMesh);
      }

      whaleGroup.add(model);

      // Debug: log model info
      const b = new THREE.Box3().setFromObject(whaleGroup);
      const s = b.getSize(new THREE.Vector3());
      const c = b.getCenter(new THREE.Vector3());
      console.log("Whale loaded:", { size: s, center: c, children: whaleGroup.children.length });
    });

    // === Orbit controls (360° rotation) ===
    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.enableZoom = true;
    controls.enablePan = false;
    controls.minDistance = 4;
    controls.maxDistance = 25;

    // === Resize ===
    function resize() {
      const r = container.getBoundingClientRect();
      renderer.setSize(r.width, r.height);
      camera.aspect = r.width / r.height;
      camera.updateProjectionMatrix();
    }

    // === Animation ===
    let time = 0;
    function animate() {
      time += 0.01;

      // Gentle floating motion
      whaleGroup.position.y = Math.sin(time * 0.5) * 0.15;

      controls.update();

      // Swimming vertex deformation (dolphin kick + fin movement)
      for (const sd of swimTargets) {
        const positions = sd.geo.getAttribute("position") as THREE.BufferAttribute;
        for (let i = 0; i < positions.count; i++) {
          const origX = sd.origPositions[i * 3];       // body length axis (model X)
          const origY = sd.origPositions[i * 3 + 1];  // vertical
          const origZ = sd.origPositions[i * 3 + 2];  // width

          // Normalize along body (0 = head, 1 = tail)
          const t = 1 - (origX - sd.zMin) / sd.zRange;

          // === Dolphin kick (tail half only, t > 0.4) ===
          const phase = time * 2.5 - t * 6.0;
          const wave = Math.sin(phase);

          // Only move rear half of body
          const tailStart = 0.4;
          const tailT = t > tailStart ? (t - tailStart) / (1 - tailStart) : 0;

          // Base amplitude: cubic increase from mid-body to tail
          const baseAmplitude = tailT * tailT * tailT * 0.9;

          // Downstroke power
          const rearFactor = tailT > 0 ? Math.pow(tailT, 1.5) : 0;
          const downPower = Math.min(wave, 0) * rearFactor * 1.2;

          // Upstroke: tail tip whips up
          const tailTip = tailT > 0.6 ? Math.pow((tailT - 0.6) / 0.4, 2) : 0;
          const upWhip = Math.max(wave, 0) * tailTip * 1.4;

          const tailWave = wave * baseAmplitude + downPower + upWhip;
          let newY = origY + tailWave;

          // === Pectoral fin flapping (phase delay from root to tip) ===
          const zNorm = (origZ - sd.xMin) / sd.xRange;
          const lateralExtent = Math.abs(zNorm - 0.5) * 2; // 0=center, 1=tip
          const isFinArea = t > 0.2 && t < 0.55 && lateralExtent > 0.35;
          if (isFinArea) {
            // Phase delays from root→tip for fluid wing motion
            const tipFactor = Math.pow((lateralExtent - 0.35) / 0.65, 1.3);
            const finPhase = Math.sin(time * 3.0 - tipFactor * 2.5);
            // Amplitude grows toward tip
            const flapDown = Math.min(finPhase, 0) * tipFactor * 1.2;
            const flapUp = Math.max(finPhase, 0) * tipFactor * 0.8;
            newY += flapDown + flapUp;
            // Forward/back sweep with same phase delay
            const sweep = Math.cos(time * 3.0 - tipFactor * 2.5) * tipFactor * 0.25;
            positions.setX(i, origX + sweep);
          }

          positions.setY(i, newY);

          // No head undulation — keep front body still
        }
        positions.needsUpdate = true;
      }

      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    }

    resize();
    animate();
    const resizeObserver = new ResizeObserver(() => resize());
    resizeObserver.observe(container);
  });
</script>
