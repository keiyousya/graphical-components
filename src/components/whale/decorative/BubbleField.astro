---
interface Props {
  density?: "light" | "medium" | "dense";
  class?: string;
}

const {
  density = "medium",
  class: className = "",
} = Astro.props;

const counts = { light: 8, medium: 16, dense: 28 };
const count = counts[density];

const dots = Array.from({ length: count }, () => ({
  left: Math.random() * 100,
  size: 1 + Math.random() * 2,
  delay: Math.random() * 8,
  duration: 8 + Math.random() * 8,
  opacity: 0.06 + Math.random() * 0.12,
}));
---

<div class:list={["fixed inset-0 pointer-events-none overflow-hidden z-0", className]}>
  {dots.map((d) => (
    <span
      class="absolute rounded-full bg-ink-400"
      style={`left: ${d.left}%; bottom: -10px; width: ${d.size}px; height: ${d.size}px; opacity: ${d.opacity}; animation: whale-float ${d.duration}s ease-in-out ${d.delay}s infinite;`}
    />
  ))}
</div>
