---
interface Props {
  status?: "online" | "idle" | "active" | "warning";
  label?: string;
  class?: string;
}

const {
  status = "online",
  label,
  class: className = "",
} = Astro.props;

const statusStyles = {
  online: "bg-ink-500",
  idle: "bg-ink-300",
  active: "bg-ink-700",
  warning: "bg-ink-400",
};
---

<div class:list={["inline-flex items-center gap-2", className]}>
  <span class:list={["size-2 rounded-full animate-whale-pulse", statusStyles[status]]} />
  {label && <span class="font-mono text-[10px] text-ink-400 uppercase tracking-wider">{label}</span>}
</div>
