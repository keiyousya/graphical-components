---
interface Props {
  size?: "sm" | "md" | "lg";
  label?: string;
  class?: string;
}

const { size = "md", label, class: className = "" } = Astro.props;

const sizes = {
  sm: "size-8",
  md: "size-16",
  lg: "size-24",
};
---

<div class:list={["inline-flex flex-col items-center gap-3", className]}>
  <div class:list={["whale-spinner relative", sizes[size]]}>
    <svg viewBox="0 0 100 100" class="size-full" fill="none">
      <!-- Outer wireframe ring -->
      <circle
        cx="50" cy="50" r="46"
        stroke="oklch(0.78 0 0)"
        stroke-width="0.5"
      />
      <!-- Outer spinning arc -->
      <circle
        cx="50" cy="50" r="46"
        stroke="oklch(0.25 0 0)"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-dasharray="72 217"
        class="spinner-outer"
      />

      <!-- Inner wireframe ring -->
      <circle
        cx="50" cy="50" r="34"
        stroke="oklch(0.85 0 0)"
        stroke-width="0.5"
      />
      <!-- Inner spinning arc (reverse) -->
      <circle
        cx="50" cy="50" r="34"
        stroke="oklch(0.35 0 0)"
        stroke-width="1"
        stroke-linecap="round"
        stroke-dasharray="40 174"
        class="spinner-inner"
      />

      <!-- Crosshair lines -->
      <line x1="50" y1="8" x2="50" y2="16" stroke="oklch(0.50 0 0 / 0.4)" stroke-width="0.5" />
      <line x1="50" y1="84" x2="50" y2="92" stroke="oklch(0.50 0 0 / 0.4)" stroke-width="0.5" />
      <line x1="8" y1="50" x2="16" y2="50" stroke="oklch(0.50 0 0 / 0.4)" stroke-width="0.5" />
      <line x1="84" y1="50" x2="92" y2="50" stroke="oklch(0.50 0 0 / 0.4)" stroke-width="0.5" />

      <!-- Center dot -->
      <circle
        cx="50" cy="50" r="2"
        fill="oklch(0.35 0 0)"
        class="animate-whale-pulse"
      />
    </svg>
  </div>
  {label && (
    <span class="font-mono text-[10px] text-ink-400 tracking-[0.15em] uppercase animate-whale-pulse">
      {label}
    </span>
  )}
</div>

<style>
  .spinner-outer {
    animation: whale-spin 2s linear infinite;
    transform-origin: center;
  }
  .spinner-inner {
    animation: whale-spin 3s linear infinite reverse;
    transform-origin: center;
  }
  @keyframes whale-spin {
    to { transform: rotate(360deg); }
  }
</style>
