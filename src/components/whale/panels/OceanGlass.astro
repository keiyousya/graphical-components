---
interface Props {
  variant?: "default" | "dark" | "subtle";
  glow?: boolean;
  corners?: boolean;
  class?: string;
}

const {
  variant = "default",
  glow = false,
  corners = true,
  class: className = "",
} = Astro.props;

const variantStyles = {
  default: "border-ink-200/40 bg-paper-50/60",
  dark: "border-ink-300/50 bg-paper-200/40",
  subtle: "border-ink-100/30 bg-paper-50/40",
};
---

<div
  class:list={[
    "relative border backdrop-blur-sm p-5",
    variantStyles[variant],
    className,
  ]}
>
  {corners && (
    <>
      <span class="absolute top-0 left-0 w-1.5 h-1.5 rounded-full bg-ink-400/40"></span>
      <span class="absolute top-0 right-0 w-1.5 h-1.5 rounded-full bg-ink-400/40"></span>
      <span class="absolute bottom-0 left-0 w-1.5 h-1.5 rounded-full bg-ink-400/40"></span>
      <span class="absolute bottom-0 right-0 w-1.5 h-1.5 rounded-full bg-ink-400/40"></span>
    </>
  )}
  <slot />
</div>

<style>
  div:hover {
    border-color: oklch(0.35 0 0 / 0.3);
  }
</style>
