---
interface Props {
  variant?: "default" | "deep" | "biolum";
  glow?: boolean;
  corners?: boolean;
  class?: string;
}

const {
  variant = "default",
  glow = false,
  corners = true,
  class: className = "",
} = Astro.props;

const variantStyles = {
  default: "border-ocean-600/25 bg-abyss-400/60",
  deep: "border-ocean-700/30 bg-abyss-500/70",
  biolum: "border-biolum-600/30 bg-abyss-400/50",
};

const glowShadow = glow ? "shadow-glow-sm" : "";
---

<div
  class:list={[
    "relative border backdrop-blur-md p-5",
    variantStyles[variant],
    glowShadow,
    className,
  ]}
>
  {corners && (
    <>
      <span class="absolute top-0 left-0 w-2 h-2 rounded-full bg-biolum-500/50"></span>
      <span class="absolute top-0 right-0 w-2 h-2 rounded-full bg-biolum-500/50"></span>
      <span class="absolute bottom-0 left-0 w-2 h-2 rounded-full bg-biolum-500/50"></span>
      <span class="absolute bottom-0 right-0 w-2 h-2 rounded-full bg-biolum-500/50"></span>
    </>
  )}
  <slot />
</div>

<style>
  div:hover {
    border-color: oklch(0.55 0.14 210 / 0.4);
    box-shadow: 0 0 16px oklch(0.55 0.14 210 / 0.1);
  }
</style>
