---
interface Props {
  tag?: "h1" | "h2" | "h3" | "h4" | "p" | "span";
  variant?: "display" | "ui" | "mono";
  glow?: boolean;
  class?: string;
}

const {
  tag: Tag = "h2",
  variant = "display",
  glow = false,
  class: className = "",
} = Astro.props;

const variantStyles = {
  display: "font-display tracking-[0.15em] uppercase text-ocean-200",
  ui: "font-ui tracking-wider text-ocean-300",
  mono: "font-mono text-biolum-400",
};
---

<Tag
  class:list={[
    variantStyles[variant],
    glow && "depth-glow",
    className,
  ]}
>
  <slot />
</Tag>

<style>
  .depth-glow {
    text-shadow:
      0 0 8px oklch(0.55 0.14 210 / 0.5),
      0 0 20px oklch(0.55 0.14 210 / 0.2);
  }
</style>
