---
import CatalogLayout from "../../../layouts/CatalogLayout.astro";
import PropTable from "../../../components/catalog/PropTable.astro";
import ComponentDemo from "../../../components/catalog/ComponentDemo.astro";
import { categories, components, getCategory } from "../../../data/components";
import { url } from "../../../utils/paths";

export function getStaticPaths() {
  return components.map((comp) => ({
    params: { category: comp.category, slug: comp.slug },
    props: { component: comp },
  }));
}

const { component } = Astro.props;
const cat = getCategory(component.category)!;

// Find prev/next components in same category
const categoryComponents = components.filter((c) => c.category === component.category);
const currentIndex = categoryComponents.findIndex((c) => c.slug === component.slug);
const prev = currentIndex > 0 ? categoryComponents[currentIndex - 1] : null;
const next = currentIndex < categoryComponents.length - 1 ? categoryComponents[currentIndex + 1] : null;

function pascalCase(slug: string) {
  return slug.split("-").map((s) => s.charAt(0).toUpperCase() + s.slice(1)).join("");
}

function generateUsageCode(comp: typeof component) {
  const name = pascalCase(comp.slug);
  const importPath = `@/components/ui/${comp.category}/${name}.astro`;
  const requiredProps = comp.props.filter((p) => p.required);
  const optionalProps = comp.props.filter((p) => !p.required).slice(0, 2);

  let propsStr = "";
  for (const p of requiredProps) {
    if (p.type === "number") propsStr += ` ${p.name}={0}`;
    else if (p.type === "string[]" || p.type.includes("Array")) propsStr += ` ${p.name}={[]}`;
    else if (p.type === "string[][]") propsStr += ` ${p.name}={[]}`;
    else propsStr += ` ${p.name}="..."`;
  }
  for (const p of optionalProps) {
    if (p.default) propsStr += ` ${p.name}=${p.default.startsWith('"') ? p.default : `{${p.default}}`}`;
  }

  const hasSlot = ["glass-panel", "holo-card", "terminal-panel", "hud-frame", "circuit-pattern", "particle-field"].includes(comp.slug);

  let code = `---\nimport ${name} from "${importPath}";\n---\n\n`;
  if (hasSlot) {
    code += `<${name}${propsStr}>\n  <!-- content -->\n</${name}>`;
  } else {
    code += `<${name}${propsStr} />`;
  }
  return code;
}
---

<CatalogLayout title={`${component.nameJa} | Graphical Components`}>
  <div class="max-w-4xl">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 font-mono text-[10px] text-cyber-700 uppercase tracking-widest mb-6">
      <a href={url("/components")} class="hover:text-cyber-400 transition-colors">Catalog</a>
      <span class="text-cyber-800">/</span>
      <a href={url(`/components/${component.category}`)} class="hover:text-cyber-400 transition-colors">
        {cat.nameJa}
      </a>
      <span class="text-cyber-800">/</span>
      <span class="text-cyber-500">{component.slug}</span>
    </nav>

    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
          <div class="flex items-center gap-3 mb-1">
            <span class="text-xl opacity-50">{cat.icon}</span>
            <h1 class="font-display text-2xl md:text-3xl tracking-wider text-cyber-200 uppercase">
              {component.nameJa}
            </h1>
          </div>
          <p class="font-mono text-xs text-cyber-700">{component.name}</p>
        </div>
        <span
          class:list={[
            "font-mono text-[10px] uppercase px-2 py-1 border shrink-0",
            component.status === "stable" && "text-status-500 border-status-600/30",
            component.status === "beta" && "text-alert-500 border-alert-600/30",
            component.status === "experimental" && "text-bio-400 border-bio-600/30",
          ]}
        >
          {component.status}
        </span>
      </div>
      <p class="font-ui text-sm text-cyber-500 mt-3">{component.description}</p>

      {component.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {component.tags.map((tag) => (
            <span class="font-mono text-[9px] text-cyber-700 border border-cyber-800/30 px-1.5 py-0.5">
              {tag}
            </span>
          ))}
        </div>
      )}

      <div class="mt-4 h-px bg-gradient-to-r from-cyber-500/50 via-cyber-800/30 to-transparent"></div>
    </div>

    <!-- Live Preview -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <div class="size-1.5 bg-status-500 animate-pulse-glow"></div>
        <h2 class="font-display text-xs tracking-widest text-cyber-400 uppercase">Live Preview</h2>
        <div class="h-px flex-1 bg-cyber-800/20"></div>
      </div>

      <div class="relative border border-cyber-800/30 bg-void-600/30 p-6">
        <!-- Preview corners -->
        <span class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-cyber-600/40"></span>
        <span class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-cyber-600/40"></span>
        <span class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-cyber-600/40"></span>
        <span class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-cyber-600/40"></span>

        <ComponentDemo component={component} />
      </div>
    </section>

    <!-- Props -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <div class="size-1.5 bg-holo-500 animate-pulse-glow"></div>
        <h2 class="font-display text-xs tracking-widest text-cyber-400 uppercase">Props</h2>
        <div class="h-px flex-1 bg-cyber-800/20"></div>
      </div>

      <div class="border border-cyber-800/30 bg-void-600/20 p-4">
        <PropTable props={component.props} />
      </div>
    </section>

    <!-- Usage -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <div class="size-1.5 bg-cyber-500 animate-pulse-glow"></div>
        <h2 class="font-display text-xs tracking-widest text-cyber-400 uppercase">Usage</h2>
        <div class="h-px flex-1 bg-cyber-800/20"></div>
      </div>

      <div class="border border-cyber-800/30 bg-void-700/60 overflow-hidden">
        <div class="flex items-center gap-2 border-b border-cyber-800/30 bg-void-600/40 px-4 py-2">
          <span class="size-2 rounded-full bg-danger-500/50"></span>
          <span class="size-2 rounded-full bg-alert-500/50"></span>
          <span class="size-2 rounded-full bg-status-500/50"></span>
          <span class="font-mono text-[10px] text-cyber-700 ml-2">usage.astro</span>
        </div>
        <pre class="p-4 font-mono text-xs text-cyber-400 leading-relaxed overflow-x-auto"><code set:text={generateUsageCode(component)} /></pre>
      </div>
    </section>

    <!-- Component info -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <div class="size-1.5 bg-alert-500 animate-pulse-glow"></div>
        <h2 class="font-display text-xs tracking-widest text-cyber-400 uppercase">Info</h2>
        <div class="h-px flex-1 bg-cyber-800/20"></div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div class="border border-cyber-800/30 bg-void-600/20 p-3">
          <p class="font-mono text-[9px] text-cyber-700 tracking-widest uppercase mb-1">Category</p>
          <p class="font-ui text-sm text-cyber-400">{cat.nameJa}</p>
        </div>
        <div class="border border-cyber-800/30 bg-void-600/20 p-3">
          <p class="font-mono text-[9px] text-cyber-700 tracking-widest uppercase mb-1">Status</p>
          <p class="font-ui text-sm text-cyber-400">{component.status}</p>
        </div>
        <div class="border border-cyber-800/30 bg-void-600/20 p-3">
          <p class="font-mono text-[9px] text-cyber-700 tracking-widest uppercase mb-1">Props</p>
          <p class="font-ui text-sm text-cyber-400">{component.props.length}</p>
        </div>
        <div class="border border-cyber-800/30 bg-void-600/20 p-3">
          <p class="font-mono text-[9px] text-cyber-700 tracking-widest uppercase mb-1">File</p>
          <p class="font-mono text-[10px] text-cyber-500 break-all">ui/{component.category}/{pascalCase(component.slug)}.astro</p>
        </div>
      </div>
    </section>

    <!-- Prev/Next navigation -->
    <nav class="flex items-stretch gap-3 border-t border-cyber-800/30 pt-6">
      {prev ? (
        <a
          href={url(`/components/${component.category}/${prev.slug}`)}
          class="flex-1 group border border-cyber-800/30 p-4 transition-all hover:border-cyber-600/50 hover:bg-void-400/20"
        >
          <p class="font-mono text-[9px] text-cyber-700 tracking-widest uppercase mb-1">&#8592; Prev</p>
          <p class="font-display text-xs text-cyber-500 group-hover:text-cyber-300 tracking-wider uppercase transition-colors">
            {prev.nameJa}
          </p>
        </a>
      ) : <div class="flex-1" />}

      {next ? (
        <a
          href={url(`/components/${component.category}/${next.slug}`)}
          class="flex-1 group border border-cyber-800/30 p-4 text-right transition-all hover:border-cyber-600/50 hover:bg-void-400/20"
        >
          <p class="font-mono text-[9px] text-cyber-700 tracking-widest uppercase mb-1">Next &#8594;</p>
          <p class="font-display text-xs text-cyber-500 group-hover:text-cyber-300 tracking-wider uppercase transition-colors">
            {next.nameJa}
          </p>
        </a>
      ) : <div class="flex-1" />}
    </nav>
  </div>
</CatalogLayout>
