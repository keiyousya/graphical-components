---
import CatalogLayout from "../../layouts/CatalogLayout.astro";
import { categories, getComponentsByCategory } from "../../data/components";
import { url } from "../../utils/paths";
---

<CatalogLayout title="All Components | Graphical Components">
  <div class="max-w-5xl">
    <!-- Page header -->
    <div class="mb-10">
      <p class="font-mono text-[10px] text-cyber-700 uppercase tracking-[0.2em] mb-2">
        CATALOG // ALL
      </p>
      <h1 class="font-display text-2xl md:text-3xl tracking-wider text-cyber-200">
        ALL <span class="text-cyber-500">COMPONENTS</span>
      </h1>
      <div class="mt-3 h-px bg-gradient-to-r from-cyber-500/50 via-cyber-800/30 to-transparent">
      </div>
    </div>

    <!-- Categories -->
    <div class="space-y-12">
      {
        categories.map((cat) => {
          const items = getComponentsByCategory(cat.id);
          return (
            <section>
              <a
                href={url(`/components/${cat.id}`)}
                class="group flex items-center gap-3 mb-4 hover:text-cyber-300 transition-colors"
              >
                <span class="text-xl opacity-50 group-hover:opacity-100 transition-opacity">
                  {cat.icon}
                </span>
                <h2 class="font-display text-sm tracking-wider text-cyber-400 group-hover:text-cyber-300 transition-colors uppercase">
                  {cat.nameJa}
                </h2>
                <span class="font-mono text-[10px] text-cyber-700">
                  {cat.name}
                </span>
                <div class="h-px flex-1 bg-cyber-800/30" />
                <span class="font-mono text-[10px] text-cyber-700">
                  {items.length}
                </span>
              </a>

              {items.length === 0 ? (
                <div class="border border-dashed border-cyber-800/30 p-6 text-center">
                  <p class="font-mono text-xs text-cyber-800">
                    // NO COMPONENTS YET
                  </p>
                  <p class="font-ui text-sm text-cyber-700 mt-1">
                    コンポーネントは今後追加されます
                  </p>
                </div>
              ) : (
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                  {items.map((item) => (
                    <a
                      href={url(`/components/${cat.id}/${item.slug}`)}
                      class="group border border-cyber-800/40 bg-void-500/50 p-4 transition-all hover:border-cyber-600/60 hover:bg-void-400/30"
                    >
                      <div class="flex items-start justify-between mb-2">
                        <h3 class="font-display text-xs tracking-wider text-cyber-400 group-hover:text-cyber-300 transition-colors">
                          {item.nameJa}
                        </h3>
                        <span
                          class:list={[
                            "font-mono text-[9px] uppercase px-1.5 py-0.5 border",
                            item.status === "stable" &&
                              "text-status-500 border-status-600/30",
                            item.status === "beta" &&
                              "text-alert-500 border-alert-600/30",
                            item.status === "experimental" &&
                              "text-bio-400 border-bio-600/30",
                          ]}
                        >
                          {item.status}
                        </span>
                      </div>
                      <p class="font-ui text-xs text-cyber-600 line-clamp-2">
                        {item.description}
                      </p>
                    </a>
                  ))}
                </div>
              )}
            </section>
          );
        })
      }
    </div>
  </div>
</CatalogLayout>
