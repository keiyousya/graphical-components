---
import CurryLayout from "../../layouts/CurryLayout.astro";
import SpiceButton from "../../components/curry/controls/SpiceButton.astro";
import CurryIndicator from "../../components/curry/feedback/CurryIndicator.astro";
import CurryPlate3D from "../../components/curry/data/CurryPlate3D.astro";
import SoftServe3D from "../../components/curry/data/SoftServe3D.astro";
import { url } from "../../utils/paths";
---

<CurryLayout title="Curry & Soft Serve | Graphical Components">
  <div class="relative min-h-dvh flex flex-col overflow-hidden">
    <!-- Background decoration -->
    <div class="fixed inset-0 pointer-events-none">
      <div class="absolute top-1/4 -left-20 w-80 h-80 rounded-full bg-spice-200/20 blur-3xl"></div>
      <div class="absolute bottom-1/4 -right-20 w-96 h-96 rounded-full bg-cream-300/30 blur-3xl"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-matcha-100/10 blur-3xl"></div>
    </div>

    <!-- Header -->
    <header class="relative z-30 flex items-center justify-between border-b border-spice-200/30 px-6 py-3">
      <div class="flex items-center gap-3">
        <CurryIndicator status="hot" label="CURRY.THEME" />
      </div>
      <a href={url("/")} class="font-mono text-[10px] text-roux-300 hover:text-spice-500 transition-colors">
        &lt;themes/&gt;
      </a>
    </header>

    <!-- Hero -->
    <main class="relative z-30 flex-1 flex flex-col items-center justify-center px-6 py-12">
      <!-- 3D Models -->
      <div class="w-full max-w-5xl grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
        <div class="relative">
          <p class="font-mono text-[10px] text-spice-400 tracking-[0.2em] uppercase text-center mb-2">Curry Rice</p>
          <CurryPlate3D size="lg" />
        </div>
        <div class="relative">
          <p class="font-mono text-[10px] text-spice-400 tracking-[0.2em] uppercase text-center mb-2">Soft Serve</p>
          <SoftServe3D size="lg" />
        </div>
      </div>

      <!-- Title -->
      <div class="relative text-center mb-6">
        <h1 class="font-display text-4xl md:text-6xl font-bold tracking-wider text-roux-700 mb-2">
          カレーとソフトクリーム
        </h1>
        <p class="font-mono text-[10px] text-spice-500 tracking-[0.25em] uppercase">
          Curry and Soft Serve Interface
        </p>
      </div>

      <!-- Info -->
      <div class="mt-4 text-center space-y-4">
        <p class="font-ui text-sm text-roux-400 tracking-wider">
          あたたかくて、おいしいUIコンポーネント
        </p>
        <div class="flex items-center justify-center gap-6 font-mono text-[10px] text-spice-400">
          <span>SPICE: ★★★</span>
          <span class="text-spice-200">|</span>
          <span>TEMP: 82°C</span>
          <span class="text-spice-200">|</span>
          <span>SERVE: SOFT</span>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-8 flex items-center gap-4">
        <SpiceButton variant="spice" href={url("/curry/showcase")}>
          Showcase
        </SpiceButton>
        <SpiceButton variant="cream" href={url("/")}>
          Themes
        </SpiceButton>
      </div>
    </main>

    <!-- Footer -->
    <footer class="relative z-30 border-t border-spice-200/30 px-6 py-3">
      <div class="flex items-center justify-between">
        <CurryIndicator status="warm" label="SIMMERING" />
        <span class="font-mono text-[10px] text-roux-300 tracking-wider">
          CURRY.THEME // GRAPHICAL.COMPONENTS
        </span>
      </div>
    </footer>
  </div>
</CurryLayout>
