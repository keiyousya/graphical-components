---
import CatalogLayout from "../../../../layouts/CyberCatalogLayout.astro";
import { categories, getComponentsByCategory, getCategory } from "../../../../data/components";
import { url } from "../../../../utils/paths";

export function getStaticPaths() {
  return categories.map((cat) => ({
    params: { category: cat.id },
  }));
}

const { category } = Astro.params;
const cat = getCategory(category!)!;
const items = getComponentsByCategory(category!);
---

<CatalogLayout title={`${cat.nameJa} | Graphical Components`}>
  <div class="max-w-5xl">
    <!-- Page header -->
    <div class="mb-10">
      <p class="font-mono text-[10px] text-cyber-700 uppercase tracking-[0.2em] mb-2">
        CATALOG // {cat.name.toUpperCase()}
      </p>
      <div class="flex items-center gap-3">
        <span class="text-2xl opacity-60">{cat.icon}</span>
        <h1 class="font-display text-2xl md:text-3xl tracking-wider text-cyber-200 uppercase">
          {cat.nameJa}
        </h1>
      </div>
      <div class="mt-3 h-px bg-gradient-to-r from-cyber-500/50 via-cyber-800/30 to-transparent"></div>
    </div>

    <!-- Component list -->
    {items.length === 0 ? (
      <div class="border border-dashed border-cyber-800/30 p-12 text-center">
        <p class="font-mono text-xs text-cyber-800">// NO COMPONENTS YET</p>
        <p class="font-ui text-sm text-cyber-700 mt-2">コンポーネントは今後追加されます</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {items.map((item) => (
          <a
            href={url(`/cyber/components/${category}/${item.slug}`)}
            class="group relative border border-cyber-800/40 bg-void-500/50 p-5 transition-all hover:border-cyber-600/60 hover:bg-void-400/30 hover:shadow-glow-sm"
          >
            {/* Corners */}
            <span class="absolute top-0 left-0 w-3 h-3 border-t border-l border-cyber-700/50 group-hover:border-cyber-500 transition-colors" />
            <span class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-cyber-700/50 group-hover:border-cyber-500 transition-colors" />

            <div class="flex items-start justify-between mb-2">
              <h3 class="font-display text-sm tracking-wider text-cyber-400 group-hover:text-cyber-300 transition-colors uppercase">
                {item.nameJa}
              </h3>
              <span
                class:list={[
                  "font-mono text-[9px] uppercase px-1.5 py-0.5 border shrink-0 ml-3",
                  item.status === "stable" && "text-status-500 border-status-600/30",
                  item.status === "beta" && "text-alert-500 border-alert-600/30",
                  item.status === "experimental" && "text-bio-400 border-bio-600/30",
                ]}
              >
                {item.status}
              </span>
            </div>

            <p class="font-mono text-[10px] text-cyber-700 mb-2">{item.name}</p>
            <p class="font-ui text-xs text-cyber-600 line-clamp-2">{item.description}</p>

            {item.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-1.5">
                {item.tags.slice(0, 4).map((tag) => (
                  <span class="font-mono text-[9px] text-cyber-700 border border-cyber-800/30 px-1.5 py-0.5">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
    )}
  </div>
</CatalogLayout>
