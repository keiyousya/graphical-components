---
import CyberLayout from "../../layouts/CyberLayout.astro";
import { categories, getComponentsByCategory } from "../../data/components";
import { url } from "../../utils/paths";
---

<CyberLayout title="Cyberpunk | Graphical Components">
  <!-- Full-screen hero -->
  <div class="relative min-h-dvh flex flex-col effect-grid">
    <!-- Vignette -->
    <div
      class="pointer-events-none fixed inset-0 z-10 bg-[radial-gradient(ellipse_at_center,transparent_40%,oklch(0.01_0.002_250/0.85))]"
    >
    </div>

    <!-- Scanline overlay -->
    <div class="pointer-events-none fixed inset-0 z-20 effect-scanlines"></div>

    <!-- Header bar -->
    <header
      class="relative z-30 flex items-center justify-between border-b border-cyber-800/40 px-6 py-3 bg-void-600/40 backdrop-blur-sm"
    >
      <div class="flex items-center gap-3">
        <div
          class="size-2 rounded-full bg-status-500 shadow-glow-status animate-pulse-glow"
        >
        </div>
        <span class="font-mono text-[10px] text-cyber-600 uppercase tracking-[0.2em]">
          SYS.INIT // GRAPHICAL.COMPONENTS.v0.1
        </span>
      </div>
      <a href={url("/")} class="font-mono text-[10px] text-cyber-700 hover:text-cyber-400 transition-colors">
        &lt;themes/&gt;
      </a>
    </header>

    <!-- Hero -->
    <main class="relative z-30 flex-1 flex flex-col items-center justify-center px-6 py-20">
      <!-- Decorative ring -->
      <div class="relative mb-12">
        <div
          class="absolute -inset-8 rounded-full border border-cyber-800/30 animate-radar-sweep"
          style="border-top-color: var(--color-cyber-500);"
        >
        </div>
        <div
          class="absolute -inset-16 rounded-full border border-cyber-900/20 animate-radar-sweep"
          style="animation-duration: 6s; animation-direction: reverse;"
        >
        </div>
        <div class="relative size-24 grid place-items-center">
          <svg
            viewBox="0 0 100 100"
            class="size-full text-cyber-500 animate-breathe"
            fill="none"
            stroke="currentColor"
            stroke-width="0.5"
          >
            <polygon points="50,5 93,27.5 93,72.5 50,95 7,72.5 7,27.5"></polygon>
            <polygon
              points="50,15 83,32.5 83,67.5 50,85 17,67.5 17,32.5"
              stroke-width="0.3"
              opacity="0.5"></polygon>
            <line x1="50" y1="25" x2="50" y2="75" stroke-width="0.3" opacity="0.4"></line>
            <line x1="25" y1="50" x2="75" y2="50" stroke-width="0.3" opacity="0.4"></line>
            <circle cx="50" cy="50" r="3" fill="currentColor" opacity="0.6"></circle>
          </svg>
        </div>
      </div>

      <!-- Title -->
      <h1
        class="font-display text-4xl md:text-6xl lg:text-7xl font-bold text-cyber-200 tracking-wider text-center mb-4 animate-fade-in-up"
      >
        <span class="text-cyber-500">CYBER</span>PUNK
      </h1>

      <!-- Subtitle -->
      <p
        class="font-mono text-sm md:text-base text-cyber-500 tracking-widest uppercase text-center mb-2 animate-fade-in-up"
        style="animation-delay: 0.15s; animation-fill-mode: both;"
      >
        Sci-Fi Futuristic UI Catalog
      </p>
      <p
        class="font-ui text-base md:text-lg text-cyber-600 text-center max-w-xl animate-fade-in-up"
        style="animation-delay: 0.3s; animation-fill-mode: both;"
      >
        Iron Man / Minority Report / Avatar
        <span class="text-cyber-700">&#8212;</span>
        ダークにシアンの近未来サイバーパンクUI
      </p>

      <!-- CTA -->
      <div
        class="mt-10 flex flex-wrap items-center gap-4 animate-fade-in-up"
        style="animation-delay: 0.45s; animation-fill-mode: both;"
      >
        <a
          href={url("/cyber/showcase")}
          class="group relative inline-flex items-center gap-3 border border-cyber-500 bg-cyber-500/10 px-8 py-3 font-display text-sm tracking-widest text-cyber-200 uppercase transition-all hover:bg-cyber-500/20 hover:shadow-glow-md"
        >
          <span>Showcase</span>
          <svg
            class="size-4 transition-transform group-hover:translate-x-1"
            fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
          <span class="absolute top-0 left-0 size-2 border-t-2 border-l-2 border-cyber-400"></span>
          <span class="absolute top-0 right-0 size-2 border-t-2 border-r-2 border-cyber-400"></span>
          <span class="absolute bottom-0 left-0 size-2 border-b-2 border-l-2 border-cyber-400"></span>
          <span class="absolute bottom-0 right-0 size-2 border-b-2 border-r-2 border-cyber-400"></span>
        </a>
        <a
          href={url("/cyber/components")}
          class="group relative inline-flex items-center gap-3 border border-cyber-700 px-8 py-3 font-display text-sm tracking-widest text-cyber-400 uppercase transition-all hover:border-cyber-500 hover:bg-cyber-500/10 hover:shadow-glow-md hover:text-cyber-200"
        >
          <span>Catalog</span>
          <span class="absolute top-0 left-0 size-2 border-t-2 border-l-2 border-cyber-400"></span>
          <span class="absolute top-0 right-0 size-2 border-t-2 border-r-2 border-cyber-400"></span>
          <span class="absolute bottom-0 left-0 size-2 border-b-2 border-l-2 border-cyber-400"></span>
          <span class="absolute bottom-0 right-0 size-2 border-b-2 border-r-2 border-cyber-400"></span>
        </a>
      </div>
    </main>

    <!-- Categories grid -->
    <section class="relative z-30 border-t border-cyber-800/40 bg-void-600/30 backdrop-blur-sm">
      <div class="max-w-6xl mx-auto px-6 py-16">
        <h2
          class="font-mono text-[10px] text-cyber-600 uppercase tracking-[0.3em] mb-8 flex items-center gap-3"
        >
          <span class="inline-block w-8 h-px bg-cyber-700"></span>
          Component Categories
          <span class="inline-block w-8 h-px bg-cyber-700"></span>
        </h2>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          {
            categories.map((cat, i) => {
              const count = getComponentsByCategory(cat.id).length;
              return (
                <a
                  href={url(`/cyber/components/${cat.id}`)}
                  class="group relative border border-cyber-800/40 bg-void-500/50 p-5 transition-all hover:border-cyber-600/60 hover:bg-void-400/30 hover:shadow-glow-sm animate-fade-in-up"
                  style={`animation-delay: ${0.05 * i}s; animation-fill-mode: both;`}
                >
                  <span class="absolute top-0 left-0 w-3 h-3 border-t border-l border-cyber-700/50 group-hover:border-cyber-500 transition-colors" />
                  <span class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-cyber-700/50 group-hover:border-cyber-500 transition-colors" />

                  <div class="text-2xl mb-3 opacity-40 group-hover:opacity-80 transition-opacity">
                    {cat.icon}
                  </div>
                  <h3 class="font-display text-xs tracking-wider text-cyber-400 group-hover:text-cyber-300 transition-colors uppercase">
                    {cat.nameJa}
                  </h3>
                  <p class="font-mono text-[10px] text-cyber-700 mt-1">{cat.name}</p>
                  <div class="mt-3 flex items-center gap-2">
                    <div class="h-px flex-1 bg-cyber-800/40" />
                    <span class="font-mono text-[10px] text-cyber-700">
                      {count} items
                    </span>
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer
      class="relative z-30 border-t border-cyber-800/30 bg-void-700/50 px-6 py-4 flex items-center justify-between"
    >
      <span class="font-mono text-[10px] text-cyber-800 tracking-widest">
        GRAPHICAL.COMPONENTS // CYBERPUNK
      </span>
      <span class="font-mono text-[10px] text-cyber-800">
        <span class="text-status-600">&#9679;</span> SYSTEM NOMINAL
      </span>
    </footer>
  </div>
</CyberLayout>
