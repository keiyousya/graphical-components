---
import "@fontsource/rajdhani/400.css";
import "@fontsource/rajdhani/600.css";
import "@fontsource/rajdhani/700.css";
import "@fontsource/jetbrains-mono/400.css";
import { url } from "../utils/paths";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="SF近未来UIコンポーネントカタログ — テーマを選択してください" />
    <title>Graphical Components</title>
  </head>
  <body>
    <div class="selector">
      <!-- Header -->
      <header class="selector-header">
        <span class="selector-logo">GRAPHICAL COMPONENTS</span>
        <span class="selector-ver">v0.1</span>
      </header>

      <main class="selector-main">
        <h1 class="selector-title">GRAPHICAL<br/>COMPONENTS</h1>
        <p class="selector-sub">SF近未来インターフェースの再利用可能コンポーネント集</p>
        <p class="selector-prompt">Select Theme</p>

        <div class="theme-grid">
          <!-- Cyberpunk -->
          <a href={url("/cyber")} class="theme-card theme-cyber">
            <div class="theme-preview">
              <div class="cyber-bar bar-1"></div>
              <div class="cyber-bar bar-2"></div>
              <div class="cyber-bar bar-3"></div>
              <div class="cyber-ring"></div>
            </div>
            <div class="theme-info">
              <h2 class="theme-name">Cyberpunk</h2>
              <p class="theme-tag">DARK // SCI-FI</p>
              <p class="theme-desc">ダークにシアンの近未来サイバーパンクUI</p>
            </div>
            <div class="theme-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </div>
          </a>

          <!-- Harmony -->
          <a href={url("/harmony")} class="theme-card theme-harmony">
            <div class="theme-preview">
              <div class="harmony-circle c-1"></div>
              <div class="harmony-circle c-2"></div>
              <div class="harmony-circle c-3"></div>
              <div class="harmony-cross">+</div>
            </div>
            <div class="theme-info">
              <h2 class="theme-name">&lt;harmony/&gt;</h2>
              <p class="theme-tag">LIGHT // DYSTOPIA</p>
              <p class="theme-desc">白基調の近未来ディストピアUI</p>
            </div>
            <div class="theme-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </div>
          </a>
          <!-- Whale -->
          <a href={url("/whale")} class="theme-card theme-whale">
            <div class="theme-preview">
              <div class="whale-wave w-1"></div>
              <div class="whale-wave w-2"></div>
              <div class="whale-wave w-3"></div>
              <div class="whale-dot wd-1"></div>
              <div class="whale-dot wd-2"></div>
              <div class="whale-dot wd-3"></div>
            </div>
            <div class="theme-info">
              <h2 class="theme-name">Whale</h2>
              <p class="theme-tag">DEEP // HOLOGRAPHIC</p>
              <p class="theme-desc">深海ホログラフィッククジラUI</p>
            </div>
            <div class="theme-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </div>
          </a>
        </div>
      </main>

      <footer class="selector-footer">
        <span>GRAPHICAL.COMPONENTS // THEME SELECT</span>
      </footer>
    </div>

    <style>
      @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes pulse {
        0%, 100% { opacity: 0.4; }
        50% { opacity: 0.8; }
      }
      @keyframes spin-slow {
        to { transform: rotate(360deg); }
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: "Rajdhani", system-ui, sans-serif;
        background: #f6f5f5;
        color: #666;
        min-height: 100dvh;
        -webkit-font-smoothing: antialiased;
      }

      .selector {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        background:
          radial-gradient(ellipse at 30% 50%, rgba(0, 180, 200, 0.04) 0%, transparent 60%),
          radial-gradient(ellipse at 70% 50%, rgba(180, 80, 100, 0.04) 0%, transparent 60%),
          #f6f5f5;
      }

      .selector-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 24px;
        border-bottom: 1px solid rgba(0,0,0,0.06);
      }
      .selector-logo {
        font-family: "Rajdhani", sans-serif;
        font-weight: 700;
        font-size: 11px;
        letter-spacing: 0.2em;
        color: #999;
      }
      .selector-ver {
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        color: #aaa;
      }

      .selector-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 24px;
        animation: fadeInUp 0.8s ease-out;
      }

      .selector-title {
        font-family: "Rajdhani", sans-serif;
        font-weight: 700;
        font-size: clamp(2rem, 6vw, 4rem);
        letter-spacing: 0.12em;
        color: #333;
        text-align: center;
        line-height: 1.1;
        margin-bottom: 12px;
      }
      .selector-sub {
        font-size: 14px;
        color: #888;
        text-align: center;
        margin-bottom: 48px;
      }
      .selector-prompt {
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: #999;
        margin-bottom: 24px;
      }

      .theme-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
        width: 100%;
        max-width: 1000px;
      }
      @media (min-width: 640px) {
        .theme-grid { grid-template-columns: 1fr 1fr 1fr; }
      }

      .theme-card {
        display: flex;
        flex-direction: column;
        border: 1px solid rgba(0,0,0,0.08);
        padding: 24px;
        text-decoration: none;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
      }
      .theme-card:hover {
        border-color: rgba(0,0,0,0.14);
        transform: translateY(-2px);
      }

      /* Cyberpunk card */
      .theme-cyber { background: rgba(0, 180, 200, 0.04); }
      .theme-cyber:hover {
        background: rgba(0, 180, 200, 0.08);
        box-shadow: 0 4px 20px rgba(0, 180, 200, 0.1);
      }
      .theme-cyber .theme-name { color: #008a95; }
      .theme-cyber .theme-tag { color: #5a9ea5; }
      .theme-cyber .theme-desc { color: #5a8a90; }
      .theme-cyber .theme-arrow { color: #008a95; }

      /* Harmony card */
      .theme-harmony { background: rgba(180, 80, 100, 0.04); }
      .theme-harmony:hover {
        background: rgba(180, 80, 100, 0.08);
        box-shadow: 0 4px 20px rgba(180, 80, 100, 0.1);
      }
      .theme-harmony .theme-name { color: #a06070; }
      .theme-harmony .theme-tag { color: #a08088; }
      .theme-harmony .theme-desc { color: #907078; }
      .theme-harmony .theme-arrow { color: #a06070; }

      /* Whale card */
      .theme-whale { background: rgba(60, 120, 180, 0.04); }
      .theme-whale:hover {
        background: rgba(60, 120, 180, 0.08);
        box-shadow: 0 4px 20px rgba(60, 120, 180, 0.1);
      }
      .theme-whale .theme-name { color: #3a7ab5; }
      .theme-whale .theme-tag { color: #5a90b0; }
      .theme-whale .theme-desc { color: #5080a0; }
      .theme-whale .theme-arrow { color: #3a7ab5; }

      .theme-preview {
        height: 80px;
        position: relative;
        margin-bottom: 16px;
        overflow: hidden;
      }

      /* Cyber preview elements */
      .cyber-bar {
        position: absolute;
        height: 2px;
        border-radius: 1px;
      }
      .bar-1 { width: 60%; top: 20px; left: 10%; background: rgba(0,160,180,0.25); }
      .bar-2 { width: 40%; top: 40px; left: 20%; background: rgba(0,160,180,0.18); }
      .bar-3 { width: 30%; top: 60px; left: 15%; background: rgba(0,160,180,0.12); }
      .cyber-ring {
        position: absolute;
        right: 15%;
        top: 50%;
        transform: translateY(-50%);
        width: 40px;
        height: 40px;
        border: 1px solid rgba(0,160,180,0.18);
        border-top-color: rgba(0,160,180,0.45);
        border-radius: 50%;
        animation: spin-slow 4s linear infinite;
      }

      /* Harmony preview elements */
      .harmony-circle {
        position: absolute;
        border: 1px solid rgba(180,100,120,0.18);
        border-radius: 50%;
      }
      .c-1 { width: 50px; height: 50px; top: 15px; left: 20%; animation: pulse 4s ease-in-out infinite; }
      .c-2 { width: 35px; height: 35px; top: 25px; left: 45%; animation: pulse 5s ease-in-out infinite 1s; }
      .c-3 { width: 60px; height: 60px; top: 10px; right: 15%; animation: pulse 6s ease-in-out infinite 2s; }
      .harmony-cross {
        position: absolute;
        right: 30%;
        top: 50%;
        transform: translateY(-50%);
        font-size: 14px;
        color: rgba(180,100,120,0.3);
        animation: pulse 3s ease-in-out infinite;
      }

      /* Whale preview elements */
      .whale-wave {
        position: absolute;
        height: 1px;
        border-radius: 50%;
        background: rgba(60, 130, 200, 0.15);
      }
      .w-1 { width: 70%; top: 30px; left: 15%; background: linear-gradient(90deg, transparent, rgba(60,130,200,0.25), transparent); }
      .w-2 { width: 50%; top: 45px; left: 25%; background: linear-gradient(90deg, transparent, rgba(60,130,200,0.18), transparent); }
      .w-3 { width: 60%; top: 60px; left: 20%; background: linear-gradient(90deg, transparent, rgba(60,130,200,0.12), transparent); }
      .whale-dot {
        position: absolute;
        border-radius: 50%;
        background: rgba(60, 150, 220, 0.3);
      }
      .wd-1 { width: 4px; height: 4px; top: 25px; left: 30%; animation: pulse 3s ease-in-out infinite; }
      .wd-2 { width: 3px; height: 3px; top: 40px; left: 55%; animation: pulse 4s ease-in-out infinite 1s; }
      .wd-3 { width: 5px; height: 5px; top: 35px; right: 20%; animation: pulse 5s ease-in-out infinite 0.5s; }

      .theme-info { flex: 1; }
      .theme-name {
        font-family: "Rajdhani", sans-serif;
        font-weight: 700;
        font-size: 18px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 4px;
      }
      .theme-tag {
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        letter-spacing: 0.15em;
        margin-bottom: 8px;
      }
      .theme-desc {
        font-size: 13px;
        line-height: 1.5;
      }
      .theme-arrow {
        position: absolute;
        bottom: 24px;
        right: 24px;
        opacity: 0;
        transform: translateX(-4px);
        transition: all 0.3s ease;
      }
      .theme-card:hover .theme-arrow {
        opacity: 1;
        transform: translateX(0);
      }

      .selector-footer {
        padding: 12px 24px;
        border-top: 1px solid rgba(0,0,0,0.06);
        text-align: center;
      }
      .selector-footer span {
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        letter-spacing: 0.15em;
        color: #bbb;
      }
    </style>
  </body>
</html>
