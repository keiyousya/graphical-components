---
import WhaleLayout from "../../layouts/WhaleLayout.astro";
import HoloWhale from "../../components/whale/data/HoloWhale.astro";
import AquaButton from "../../components/whale/controls/AquaButton.astro";
import DepthIndicator from "../../components/whale/feedback/DepthIndicator.astro";
import { url } from "../../utils/paths";
---

<WhaleLayout title="Whale | Graphical Components">
  <div class="relative min-h-dvh flex flex-col overflow-hidden">
    <!-- Header -->
    <header
      class="relative z-30 flex items-center justify-between border-b border-ink-100/40 px-6 py-3"
    >
      <div class="flex items-center gap-3">
        <DepthIndicator status="online" label="WHALE.THEME" />
      </div>
      <a href={url("/")} class="font-mono text-[10px] text-ink-300 hover:text-ink-600 transition-colors">
        &lt;themes/&gt;
      </a>
    </header>

    <!-- Hero -->
    <main class="relative z-30 flex-1 flex flex-col items-center justify-center px-6 py-8">
      <!-- Title -->
      <div class="relative text-center mb-6">
        <h1 class="font-display text-4xl md:text-6xl tracking-[0.2em] uppercase text-ink-700 mb-2">
          WHALE
        </h1>
        <p class="font-mono text-[10px] text-ink-300 tracking-[0.25em] uppercase">
          Monochrome Wireframe Interface
        </p>
      </div>

      <!-- 3D Whale -->
      <div class="w-full max-w-4xl animate-whale-float">
        <HoloWhale size="xl" />
      </div>

      <!-- Info -->
      <div class="mt-4 text-center space-y-4">
        <p class="font-ui text-sm text-ink-400 tracking-wider">
          ワイヤーフレームクジラインターフェース
        </p>
        <div class="flex items-center justify-center gap-6 font-mono text-[10px] text-ink-300">
          <span>DEPTH: 2,400m</span>
          <span class="text-ink-200">|</span>
          <span>TEMP: 2.3°C</span>
          <span class="text-ink-200">|</span>
          <span>PRESSURE: 241 ATM</span>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-8 flex items-center gap-4">
        <AquaButton variant="dark" href={url("/whale/showcase")}>
          Showcase
        </AquaButton>
        <AquaButton variant="default" href={url("/")}>
          Themes
        </AquaButton>
      </div>
    </main>

    <!-- Footer -->
    <footer class="relative z-30 border-t border-ink-100/40 px-6 py-3">
      <div class="flex items-center justify-between">
        <DepthIndicator status="idle" label="SONAR.ACTIVE" />
        <span class="font-mono text-[10px] text-ink-300 tracking-wider">
          WHALE.THEME // GRAPHICAL.COMPONENTS
        </span>
      </div>
    </footer>
  </div>
</WhaleLayout>
