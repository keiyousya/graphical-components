---
import WhaleLayout from "../../layouts/WhaleLayout.astro";
import HoloWhale from "../../components/whale/data/HoloWhale.astro";
import OceanGlass from "../../components/whale/panels/OceanGlass.astro";
import AquaButton from "../../components/whale/controls/AquaButton.astro";
import DepthText from "../../components/whale/typography/DepthText.astro";
import DepthIndicator from "../../components/whale/feedback/DepthIndicator.astro";
import WhaleSpinner from "../../components/whale/feedback/WhaleSpinner.astro";
import SectionHeader from "../../components/whale/catalog/SectionHeader.astro";
import DemoBlock from "../../components/whale/catalog/DemoBlock.astro";
import { url } from "../../utils/paths";
---

<WhaleLayout title="Showcase | Whale">
  <div class="relative min-h-dvh">
    <!-- Header -->
    <header class="sticky top-0 z-50 border-b border-ink-100/40 bg-paper-50/80 backdrop-blur-md px-6 py-3">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <a href={url("/whale")} class="flex items-center gap-3">
          <DepthIndicator status="online" />
          <span class="font-display text-xs tracking-[0.15em] text-ink-500 uppercase">
            WHALE
          </span>
        </a>
        <nav class="flex items-center gap-4 font-mono text-[10px] text-ink-400">
          <a href={url("/whale")} class="hover:text-ink-700 transition-colors">HOME</a>
          <a href={url("/whale/showcase")} class="text-ink-700">SHOWCASE</a>
          <a href={url("/")} class="hover:text-ink-700 transition-colors">THEMES</a>
        </nav>
      </div>
    </header>

    <main class="relative z-10 max-w-7xl mx-auto px-6 py-12 space-y-20">

      <!-- 3D Component -->
      <section id="three">
        <SectionHeader title="3D Component" tag="three.js" />
        <div class="space-y-6">
          <DemoBlock title="Wireframe Whale" label="ワイヤーフレームクジラ">
            <HoloWhale size="xl" />
          </DemoBlock>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <DemoBlock title="Medium Size" label="ミディアム">
              <OceanGlass variant="subtle">
                <HoloWhale size="md" />
              </OceanGlass>
            </DemoBlock>
            <DemoBlock title="Small Size" label="スモール">
              <OceanGlass variant="subtle">
                <HoloWhale size="sm" />
              </OceanGlass>
            </DemoBlock>
          </div>
        </div>
      </section>

      <!-- Panels -->
      <section id="panels">
        <SectionHeader title="Panels" tag="panels" />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <DemoBlock title="Default" label="デフォルト">
            <OceanGlass>
              <p class="font-ui text-sm text-ink-500">モノクロームパネル</p>
              <p class="font-mono text-[10px] text-ink-300 mt-2">default variant</p>
            </OceanGlass>
          </DemoBlock>
          <DemoBlock title="Dark" label="ダーク">
            <OceanGlass variant="dark">
              <p class="font-ui text-sm text-ink-500">ダークパネル</p>
              <p class="font-mono text-[10px] text-ink-300 mt-2">dark variant</p>
            </OceanGlass>
          </DemoBlock>
          <DemoBlock title="Subtle" label="サトル">
            <OceanGlass variant="subtle">
              <p class="font-ui text-sm text-ink-500">サトルパネル</p>
              <p class="font-mono text-[10px] text-ink-300 mt-2">subtle variant</p>
            </OceanGlass>
          </DemoBlock>
        </div>
      </section>

      <!-- Controls -->
      <section id="controls">
        <SectionHeader title="Controls" tag="controls" />
        <DemoBlock title="Buttons" label="ボタン">
          <OceanGlass variant="subtle">
            <div class="flex flex-wrap gap-3">
              <AquaButton variant="default">Default</AquaButton>
              <AquaButton variant="dark">Dark</AquaButton>
              <AquaButton variant="subtle">Subtle</AquaButton>
            </div>
            <div class="flex flex-wrap gap-3 mt-4">
              <AquaButton variant="default" size="sm">Small</AquaButton>
              <AquaButton variant="default" size="md">Medium</AquaButton>
              <AquaButton variant="default" size="lg">Large</AquaButton>
            </div>
          </OceanGlass>
        </DemoBlock>
      </section>

      <!-- Typography -->
      <section id="typography">
        <SectionHeader title="Typography" tag="type" />
        <DemoBlock title="Text Styles" label="テキスト">
          <OceanGlass variant="subtle">
            <div class="space-y-4">
              <DepthText tag="h1" variant="display" class="text-3xl">WIREFRAME</DepthText>
              <DepthText tag="h2" variant="display" class="text-xl">Monochrome Interface</DepthText>
              <DepthText tag="p" variant="ui" class="text-base">モノクロームワイヤーフレームインターフェース</DepthText>
              <DepthText tag="span" variant="mono" class="text-sm">DEPTH: 2,400m // STATUS: ACTIVE</DepthText>
            </div>
          </OceanGlass>
        </DemoBlock>
      </section>

      <!-- Feedback -->
      <section id="feedback">
        <SectionHeader title="Feedback" tag="status" />
        <DemoBlock title="Loading" label="ローディング">
          <OceanGlass variant="subtle">
            <div class="flex flex-wrap items-end gap-8">
              <WhaleSpinner size="sm" label="SM" />
              <WhaleSpinner size="md" label="LOADING" />
              <WhaleSpinner size="lg" label="LG" />
            </div>
          </OceanGlass>
        </DemoBlock>
        <DemoBlock title="Indicators" label="ステータス">
          <OceanGlass variant="subtle">
            <div class="flex flex-wrap gap-6">
              <DepthIndicator status="online" label="ONLINE" />
              <DepthIndicator status="idle" label="IDLE" />
              <DepthIndicator status="active" label="ACTIVE" />
              <DepthIndicator status="warning" label="WARNING" />
            </div>
          </OceanGlass>
        </DemoBlock>
      </section>

    </main>

    <!-- Footer -->
    <footer class="relative z-10 border-t border-ink-100/40 px-6 py-4 mt-20">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <DepthIndicator status="online" label="SHOWCASE.ACTIVE" />
        <span class="font-mono text-[10px] text-ink-300 tracking-wider">
          WHALE.THEME // GRAPHICAL.COMPONENTS
        </span>
      </div>
    </footer>
  </div>
</WhaleLayout>
